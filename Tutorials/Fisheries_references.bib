	pages = {319--339},
	annote = {Comment: Published in at http://dx.doi.org/10.1214/11-STS381 the Statistical Science (http://www.imstat.org/sts/) by the Institute of Mathematical Statistics (http://www.imstat.org)},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\PXDAF4EP\\Multivariate logistic regression Bayesian (DuMouchel 2012).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\JTJJ9FBX\\DuMouchel - 2012 - Multivariate Bayesian Logistic Regression for Analysis of Clinical Study Safety Issues.pdf:application/pdf},
