@article{Francis2021,
	title = {Management implications of long transients in ecological systems},
	issn = {2397334X},
	doi = {10.1038/s41559-020-01365-0},
	abstract = {This chapter presents the fundamentals of ecology to help engineers preclude, minimize, and/or mitigate adverse infrastructure impacts. This knowledge base enables engineers to design infrastructure systems that contribute to productive, environmentally restorative, and socially desirable uses of land and protection of native flora and fauna. While ecosystems provide many invaluable services for humans and the environment, unsustainable activities affect the flows of energy within and among these ecosystems, causing loss or degradation of ecosystem services. Infrastructure can also indirectly affect ecosystems, by altering material and energy flows through a system or by damaging ecosystem function. The resulting damage can cause cascading impacts throughout an ecosystem. In the United States, the effects of human activities on ecosystems have been significant, including extensive habitat loss and fragmentation.},
	journal = {Nature Ecology \& Evolution},
	publisher = {Springer Science and Business Media LLC},
	author = {Francis, Tessa B. and Abbott, Karen C. and Cuddington, Kim and Gellner, Gabriel and Hastings, Alan and Lai, Ying-Cheng and Morozov, Andrew and Petrovskii, Sergei and Zeeman, Mary Lou},
	month = jan,
	year = {2021},
	pages = {1--10},
}

@article{Thomas2017,
	title = {Harbour seals target juvenile salmon of conservation concern},
	volume = {74},
	issn = {12057533},
	doi = {10.1139/cjfas-2015-0558},
	abstract = {Knowing the species and life stages of prey that predators consume is important for understanding the impacts that predation may have on prey populations, but traditional methods for determining diets often cannot provide sufficient detail. We combined data from two methods of scat analysis (DNA metabarcoding and morphological prey ID) to quantify the species and life stages of salmon (Oncorhynchus spp.) consumed by harbour seals (Phoca vitulina) in the Strait of Georgia, Canada, where juvenile Chinook (Oncorhynchus tshawytscha) and coho (Oncorhynchus kisutch) salmon survival is poor. Harbour seals primarily consumed adult salmon of lesser conservation concern in the fall (August–November): chum (Oncorhynchus keta: 18.4\%), pink (Oncorhynchus gorbuscha: 12.6\%), sockeye (Oncorhynchus nerka: 7.4\%), Chinook (7.1\%), and coho (1.8\%). However, the opposite species trend occurred during the spring when seals preferred juvenile salmon of greater conservation concern (April–July): coho (2.9\%), Chinook (2.9\%), sockeye (2.5\%), pink (1.4\%), and chum (0.8\%)—percentages that can equate to many individuals consumed. Our data suggest that harbour seals select juveniles of salmon species that out-migrate at ages {\textgreater}1 year and provide evidence of a potential causal relationship between harbour seal predation and juvenile salmon survival trends.},
	number = {6},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	publisher = {Canadian Science Publishing},
	author = {Thomas, Austen C. and Nelson, Benjamin W. and Lance, Monique M. and Deagle, Bruce E. and Trites, Andrew W.},
	year = {2017},
	pages = {907--921},
}

