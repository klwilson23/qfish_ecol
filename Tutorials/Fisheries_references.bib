@article{Rousset2004,
	title = {Inclusive fitness for traits affecting metapopulation demography},
	volume = {65},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {00405809},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0040580903001308},
	doi = {10.1016/j.tpb.2003.09.003},
	abstract = {Deﬁning computable analytical measures of the effects of selection in populations with demographic and environmental stochasticity is a long-standing problem. We derive an analytical measure which takes in account all consequences ofthe discrete nature ofdeme size. Expressions ofthis measure are detailed for inﬁnite island models ofpopulation structure. As an illustration we consider the evolution ofdispersal in populations made ofsmall demes with environmental and demographic stochasticity. We conﬁrm some results obtained from the analysis of models based on deterministic approximations. In particular, when there is an Allee effect, we show that evolution of the dispersal rate may lead the metapopulation to extinction. Thus, selection on the dispersal rate could restrict the distribution of species subject to Allee effects. This selection-driven extinction is prevented by kin selection when the environmental extinction rate is small.},
	language = {en},
	number = {2},
	urldate = {2026-04-20},
	journal = {Theoretical Population Biology},
	author = {Rousset, François and Ronce, Ophélie},
	month = mar,
	year = {2004},
	keywords = {Dynamics, Dispersal, Allee effects, Kin selection, Selection-driven extinction},
	pages = {127--141},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\LD3LHE3J\\Rousset and Ronce 2004 - Inclusive fitness for traits affctive metapopulation demography.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\VXT3ZJ8P\\Rousset and Ronce - 2004 - Inclusive fitness for traits affecting metapopulation demography.pdf:application/pdf},
}

