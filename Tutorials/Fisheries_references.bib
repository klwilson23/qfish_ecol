	copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
	issn = {0706-652X, 1205-7533},
	shorttitle = {Optimal {Use} of {Creel} {Survey} {Data} in {Assessing} {Population} {Behaviour}},
	url = {http://www.nrcresearchpress.com/doi/10.1139/f87-325},
	doi = {10.1139/f87-325},
	abstract = {Creel survey and independent assessment data on the lake trout (Salvelinus namaycush) and smallmouth bass (Micropterus dolomieui) populations of Lake Opeongo were evaluated. Annual estimates of total mortality, fishing mortality, and abundance were generated for each population over the period 1936–83. Large variations in survey efficiency, angler efficiency, fishing mortality, and abundance were identified over this period. We argue that a creel survey, which is expected to provide reliable information on fish population dynamics, requires an overall study design which includes collection of data on the number and relative efficiency of different kinds of anglers and periodic assessment studies aimed at providing independent checks on both survey effectiveness and population behaviour.},
	language = {en},
	number = {S2},
	urldate = {2026-04-20},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	author = {Shuter, B. J. and Matuszek, J. E. and Regier, H. A.},
	month = dec,
	year = {1987},
	pages = {s229--s238},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\EAMJIW8M\\Lake trout and bass catch and catchability Opeongo (Shuter et al. 1987).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\7Z29QU5A\\Shuter et al. - 1987 - Optimal Use of Creel Survey Data in Assessing Population Behaviour Lake Opeongo Lake Trout ( Sal.pdf:application/pdf},
}

@article{Shuter2010,
	title = {Empirical {Predictors} of {Annual} {Surface} {Water} {Temperature} {Cycles} in {North} {American} {Lakes}},
	volume = {40},
	copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
	issn = {0706-652X, 1205-7533},
	url = {http://www.nrcresearchpress.com/doi/10.1139/f83-213},
	doi = {10.1139/f83-213},
	abstract = {Annual surface water temperature cycles of temperate zone lakes can be adequately described by a symmetrical sine wave of distinct amplitude and duration. The relationships between these sine wave components and climatic and morphometric variables were analyzed for 87 lakes spread over most of North America, and for 25 lakes located in south-central Ontario, Canada. Multiple regression equations are reported which permit estimation of the maximum annual surface water temperature (amplitude: AP) and the number of ice-free days (duration: DR) for a specific lake from data on long-term mean annual air temperature (TEMP), mean depth [Formula: see text], and fetch (FT). These estimates can be used to calculate mean surface water temperature for just the ice-free period or for an entire year.},
	language = {en},
	number = {10},
	urldate = {2026-04-20},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	author = {Shuter, B. J. and Schlesinger, D. A. and Zimmerman, A. P.},
	month = oct,
