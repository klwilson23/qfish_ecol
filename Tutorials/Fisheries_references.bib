	pages = {193--203},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\JU6S8EN2\\Ermine - 2007 - The Ethical Space of Engagement.pdf:application/pdf},
}

@article{English2024,
	title = {Spatial restrictions hinder avoidance of choke species in an {Indigenous} rights‐based fishery},
	volume = {6},
	issn = {2575-8314, 2575-8314},
	url = {https://besjournals.onlinelibrary.wiley.com/doi/10.1002/pan3.10554},
	doi = {10.1002/pan3.10554},
	abstract = {Abstract
            
              
                
                  
                    Nutrient‐rich waters along the Pacific coast of North America support diverse fish communities that have helped sustain coastal peoples for millennia. Five Nuu‐chah‐nulth First Nations on the west coast of what is now known as Vancouver Island, Canada, hold constitutional Indigenous rights to conduct a multispecies community fishery, which includes Pacific Halibut (
                    Hippoglossus stenolepis
                    ). A 2009 court decision defined the extent of these Indigenous rights to be within 9 nm of the coast, thereby not fully recognizing the knowledge and authority of the traditional leadership and raising concerns about the potential for an increase in rockfish bycatch. Yelloweye Rockfish (
                    Sebastes ruberrimus
                    ) are a potential ‘choke’ species for this fishery because the two species occupy similar depth ranges. A choke species is one that is caught incidentally while targeting other species and, if caught in excess of its quota limits, can trigger a halt to fishing on the target species.
                  
                
                
                  Guided by the insights of local Indigenous peoples and using both fishery‐independent survey and commercial longline catch data, we investigated the effects of fishing depth and spatial restriction on the relative catch weights of these two species using spatiotemporal models.
                
                
                  We find evidence that a confined fishing area can limit opportunities for avoiding choke species. Specifically, fishing at depths deeper than 175 m, which occur outside the court defined area (CDA), would provide more opportunities for catching halibut while avoiding Yelloweye Rockfish than are currently available within the CDA.
                
                
                  This Indigenous‐informed, analytical approach to a management problem is just one example of how Western scientists can engage in coproduction of knowledge with Indigenous peoples to transition from the ‘status quo’ towards a practice of ‘Two‐Eyed Seeing’ that more effectively balances Indigenous rights and species conservation.
                
                
                  Policy implications: Our study highlights (1) the importance of considering choke species distributions and opportunities for their avoidance when implementing spatial harvest restrictions and (2) how related analytical and management decisions can benefit from being guided by the advice of Indigenous knowledge holders.
                
              
            
            
              Read the free
              Plain Language Summary
              for this article on the Journal blog.
            
          , 
            Résumé
            
              
                
                  
                    Les eaux riches en éléments nutritifs le long de la côte du Pacifique en Amérique du Nord abritent diverses communautés de poissons qui ont contribué à soutenir les populations côtières pendant des millénaires. Cinq Premières Nations Nuu‐chah‐nulth sur la côte ouest, qui est aujourd'hui connue comme l'île de Vancouver, au Canada, détiennent des droits constitutionnels ancestraux pour la pratique d'une pêche communautaire plurispécifique, qui inclut notamment le flétan du Pacifique (
                    Hippoglossus stenolepis
                    ). En 2009, une décision du tribunal définissait que l'étendue de ces droits ancestraux allait jusqu'à 9 milles marins de la côte, ce qui ne reconnaissait pas pleinement le savoir et l'autorité des dirigeants traditionnels et soulevait des préoccupations quant à la possibilité d'une augmentation des prises accessoires de sébaste. Le sébaste aux yeux jaunes (
                    Sebastes ruberrimus
                    ) est une espèce potentiellement « déterminante » pour cette pêche, car les deux espèces occupent des plages de profondeur similaires. Une espèce déterminante est une espèce qui est capturée de façon accessoire dans une pêche qui cible d'autres espèces et, si le nombre de prises dépasse les quotas, cela peut entraîner un arrêt de la pêche de l'espèce cible.
                  
                
                
                  Guidés par les renseignements des peuples autochtones locaux et utilisant à la fois des données de relevé indépendant de la pêche et des données commerciales sur les prises à la palangre, nous avons étudié les effets de la profondeur de pêche et de la restriction spatiale sur le poids relatif des prises de ces deux espèces à l'aide de modèles spatiotemporels.
                
                
                  Les données démontrent qu'une zone de pêche exiguë peut limiter les possibilités d'évitement des espèces déterminantes. Plus précisément, une pêche à des profondeurs de plus de 175 mètres, qui se pratique à l'extérieur de la zone définie par le tribunal, fournirait plus de possibilités de capture du flétan tout en évitant le sébaste aux yeux jaunes qui est actuellement accessible dans la zone définie par le tribunal.
                
                
                  Cette approche analytique et fondée sur les renseignements des Autochtones utilisée pour régler un problème de gestion n'est qu'un exemple parmi d'autres de la manière dont les scientifiques occidentaux peuvent participer à la coproduction de connaissances avec les peuples autochtones pour passer du « statu quo » à une approche à double perspective qui équilibre plus efficacement les droits ancestraux et la conservation des espèces.
                
                
                  Incidences sur les politiques générales: Notre étude souligne (1) l'importance de tenir compte de la répartition des espèces déterminantes et des possibilités d'évitement lors de la mise en œuvre de restrictions de pêche spatiales et (2) la façon dont on peut tirer profit des conseils des détenteurs de savoir autochtone pour prendre des décisions d'analyse et de gestion connexes.
                
              
            
          , 
            
              Read the free
              Plain Language Summary
              for this article on the Journal blog.},
	language = {en},
	number = {1},
	urldate = {2023-11-22},
	journal = {People and Nature},
	author = {English, Philina A. and Picco, Candace M. and Edwards, Jessica C. and Haggarty, Dana R. and Forrest, Robyn E. and Anderson, Sean C.},
	month = nov,
	year = {2023},
	keywords = {Indigenous rights, bycatch, commercial longline data, community fishery, spatial management, spatiotemporal random fields, species distribution modelling (SDM)},
	pages = {pan3.10554},
	file = {English et al. - 2023 - Spatial restrictions hinder avoidance of choke spe.pdf:C\:\\Users\\kylel\\Zotero\\storage\\7XJRGJAU\\English et al. - 2023 - Spatial restrictions hinder avoidance of choke spe.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\WH7GG2U4\\People and Nature - 2023 - English - Spatial restrictions hinder avoidance of choke species in an Indigenous rights‐based.pdf:application/pdf},
}

