@article{Kaller2011,
	title = {Effects of spatial scale on assessment of dissolved oxygen dynamics in the {Atchafalaya} {River} {Basin}, {Louisiana}},
	volume = {658},
	copyright = {http://www.springer.com/tdm},
	issn = {0018-8158, 1573-5117},
	url = {http://link.springer.com/10.1007/s10750-010-0470-x},
	doi = {10.1007/s10750-010-0470-x},
	abstract = {Low levels of dissolved oxygen (DO) are potential stressors of fishes{\textbackslash}nand invertebrates in freshwater and marine systems. Because of the{\textbackslash}nincredibly nutrient-rich and warm nature of the Atchafalaya River Basin{\textbackslash}n(ARB), microbial decomposition in backwater areas with limited flow{\textbackslash}noften results in potentially stressful, if not lethal, DO levels during{\textbackslash}nand after the annual flood pulse. As water temperatures increase and{\textbackslash}nflood levels fall, DO levels often stratify, restricting fish habitat.{\textbackslash}nIn order to better guide development of water management projects, we{\textbackslash}ninvestigated the relationship between DO and DO stratification (DOD;{\textbackslash}nsurface DO - bottom DO) and a suite of environmental variables{\textbackslash}npotentially linked to DO and DOD. Based on continuous monitoring data{\textbackslash}ncollected from 2000 to 2007, we used a variable selection procedure to{\textbackslash}nconstruct statistical generalized linear models to describe the{\textbackslash}nrelationship between DO levels and DOD and several potentially important{\textbackslash}npredictor variables at three spatial scales: the entire sampled area of{\textbackslash}nthe ARB; individual water management units (WMUs) or subunits (WMSs);{\textbackslash}nand individual sampling sites. We conducted these analyses using models{\textbackslash}nthat assume the normal distribution and compared them to models that{\textbackslash}nincorporate alternate error terms based on other error term{\textbackslash}ndistributions. Goodness of fit statistics suggested that our analyses{\textbackslash}nbest described the relationship between DO and structuring variables at{\textbackslash}nthe WMU/WMS scale. At this scale, water temperature, river stage height,{\textbackslash}ncurrent velocity, and to a lesser extent, water depth appeared to be the{\textbackslash}nmost important measured variables that influence DO levels. We suggest{\textbackslash}nthat management decisions at the WMU and WMS scales will offer the{\textbackslash}ngreatest potential benefits for improvement of DO conditions in the ARB.},
	language = {en},
	number = {1},
	urldate = {2026-04-20},
	journal = {Hydrobiologia},
	author = {Kaller, M. D. and Kelso, W. E. and Halloran, B. T. and Rutherford, D. A.},
	month = jan,
	year = {2011},
	keywords = {Dissolved oxygen, Atchafalaya River, Bottomland hardwood forest, Water management},
	pages = {7--15},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\X4HPBD6X\\Dissolved oxygen responses to environment (Kaller et al. 2011).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\NTJGS589\\Kaller et al. - 2011 - Effects of spatial scale on assessment of dissolved oxygen dynamics in the Atchafalaya River Basin,.pdf:application/pdf},
}

