@article{bowling_effect_2012-1,
	title = {The effect of changes in habitat conditions on the movement of juvenile {Snail} {Kites} {Rostrhamus} sociabilis},
	volume = {154},
	issn = {00191019},
	doi = {10.1111/j.1474-919X.2012.01231.x},
	abstract = {The degradation of habitats due to human activities is a major topic of interest for the conservation and management of wild populations. There is growing evidence that the Florida Everglades ecosystem continues to suffer from habitat degradation. After a period of recovery in the 1990s, the Snail Kite Rostrhamus sociabilis population suffered a substantial decline in 2001 and has not recovered since. Habitat degradation has been suggested as one of the primary reasons for this lack of recovery. As a consequence of the continued degradation of the Everglades, we hypothesized that this would have led to increased movement of juvenile Kites over time, as a consequence of the need to find more favourable habitat. We used multistate mark-recapture models to compare between-site movement probabilities of juvenile Snail Kites in the 1990s (1992-95; which corresponds to the period before the decline) and 2000s (2003-06; after the decline). Our analyses were based on an extensive radiotelemetry study (266 birds tracked monthly over the entire state of Florida for a total period of 6 years) and considered factors such as sex and age of marked individuals. There was evidence of increased movement of juvenile Snail Kites during the post-decline period from most of the wetland regions used historically by Kites. Higher movement rates may contribute to an increase in the probability of mortality of young individuals and could contribute to the observed declines. -® 2012 The Authors. Ibis -® 2012 British Ornithologists' Union},
	number = {3},
	journal = {Ibis},
	author = {Bowling, Andrea C. and Martin, Julien and Kitchens, Wiley M.},
	year = {2012},
	keywords = {Endangered species, Habitat degradation, Mark-recapture, Maximum likelihood estimation, Radiotelemetry},
	pages = {554--565},
	file = {Bowling et al. - 2012 - The effect of changes in habitat conditions on the movement of juvenile Snail Kites Rostrhamus socia.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Bowling et al. - 2012 - The effect of changes in habitat conditions on the movement of juvenile Snail Kites Rostrhamus socia.pdf:application/pdf},
}

