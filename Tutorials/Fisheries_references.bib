	pages = {389--402},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\6VW28IGF\\Bioenergetics and life history (Jorgensen et al. 2016).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\Y2XWD6HD\\Jørgensen et al. - 2016 - Modelling and interpreting fish bioenergetics a role for behaviour, life‐history traits and surviva.pdf:application/pdf},
}

@article{Kacelnik2006,
