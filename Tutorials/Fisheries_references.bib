	file = {Ignace et al. - 2023 - Researchers’ responsibility to uphold Indigenous r.pdf:C\:\\Users\\kylel\\Zotero\\storage\\N54VV4PJ\\Ignace et al. - 2023 - Researchers’ responsibility to uphold Indigenous r.pdf:application/pdf},
