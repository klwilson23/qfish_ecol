@article{schiano_evaluation_2024,
	title = {Evaluation of alternative harvest policies for striped bass and their prey, {Atlantic} menhaden},
	volume = {81},
	copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
	issn = {0706-652X, 1205-7533},
	url = {https://cdnsciencepub.com/doi/10.1139/cjfas-2023-0089},
	doi = {10.1139/cjfas-2023-0089},
	abstract = {Ecosystem approaches to fisheries management are being explored worldwide, but few evaluations of multispecies harvest control rules (HCRs) exist. Our goal was to perform a simulation test of a suite of HCRs using an age-structured predator–prey model to represent the dynamics of a small pelagic fish, Atlantic menhaden ( Brevoortia tyrannus), and its predator, striped bass ( Morone saxatilis). We evaluated a suite of static and dynamic single and multispecies HCRs to estimate effects on stock performance metrics. No single HCR achieved ecosystem management objectives for both stocks given their current reference points, but HCRs that involved the “40–10 rule” for striped bass performed well across all predator performance metrics. The most influential factor determining performance of striped bass HCRs was striped bass fishing mortality, and relatively few HCRs achieved target SSB for Atlantic menhaden. Our study indicated that some HCRs recommended for forage fish management may not be effective in systems with generalist predators, and that ecosystem management objectives might be achievable by simultaneously adopting HCRs for both predator and prey stocks that complement one another.},
	language = {en},
	number = {8},
	urldate = {2024-08-13},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	author = {Schiano, Samantha and Nesslage, Geneviève M. and Drew, Katie and Schueller, Amy M. and Woodland, Ryan J. and Wilberg, Michael J.},
