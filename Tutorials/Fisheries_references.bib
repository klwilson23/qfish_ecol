	pages = {82--87},
	file = {Killgore et al. - 1998 - Response of Littoral Fishes in Upper Lake Marion, South Carolina Following Hydrilla Control by Tripl 26.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Killgore et al. - 1998 - Response of Littoral Fishes in Upper Lake Marion, South Carolina Following Hydrilla Control by Tripl 26.pdf:application/pdf},
