@article{Gundersen2001a,
	title = {Source–sink dynamics: how sinks affect demography of sources},
	volume = {4},
	issn = {1461-023X, 1461-0248},
	shorttitle = {Source–sink dynamics},
	url = {https://onlinelibrary.wiley.com/doi/10.1046/j.1461-0248.2001.00182.x},
	doi = {10.1046/j.1461-0248.2001.00182.x},
	abstract = {Models of source±sink population dynamics have to make assumptions about whether, and eventually how, demographic parameters in source habitats are dependent on the demography in sink habitats. However, the empirical basis for making such assumptions has been weak. Here we report a study on experimental root vole populations, where estimates of demographic parameters were contrasted between source patches in source±sink (treatment) and source±source systems (control). In the presence of a sink patch (simulated by a pulsed removal of immigrants), source-patch populations failed to increase over the breeding season, mainly due to a high spatially density-dependent dispersal rate from source to sink patches. The per capita recruitment rate was almost two times higher in source±sink than in the source±source systems, but this did not compensate for the loss rate due to dispersal from source to sink patches. Sex ratio in the source±sink systems became less female biased, probably as a result of an enhanced frequency of dispersal movements in females. Good knowledge of the degree of density-and habitatdependent dispersal is critical for predicting the dynamics of source±sink populations.},
	language = {en},
	number = {1},
	urldate = {2026-04-20},
	journal = {Ecology Letters},
	author = {Gundersen, G. and Johannesen, E. and Andreassen, H.P. and Ims, R.A.},
	month = jan,
	year = {2001},
	keywords = {Demography, Dispersal, Experimental model system, Metapopulation, Microtus, Source-sink population},
	pages = {14--21},
	file = {Gundersen et al. - 2001 - Source-sink dynamics How sinks affect demography of sources.pdf:C\:\\Users\\kylel\\Zotero\\storage\\4BNKSTVS\\Gundersen et al. - 2001 - Source-sink dynamics How sinks affect demography of sources.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\NQEKI3BS\\Gundersen et al. - 2001 - Source-sink dynamics How sinks affect demography of sources.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\PUS2Y8FB\\Gundersen et al. - 2001 - Source-sink dynamics how sinks affect demography of sources.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\5SPYYED7\\Gundersen et al. - 2001 - Source–sink dynamics how sinks affect demography of sources.pdf:application/pdf},
}

@article{Gunn1995,
