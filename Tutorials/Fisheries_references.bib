@article{Ruggerone2023,
	title = {From diatoms to killer whales: impacts of pink salmon on {North} {Pacific} ecosystems},
	volume = {719},
	issn = {16161599},
	url = {http://dx.doi.org/10.3354/meps14402},
	doi = {10.3354/meps14402},
	abstract = {In response to a climate regime shift in 1977 and general heating of the North Pacific Ocean, pink salmon Oncorhynchus gorbuscha abundance reached record highs during 2005−2021, comprising 70\% of all Pacific salmon. Pink salmon are approximately 25 times more numerous in odd- than even-numbered calendar years in some major North Pacific ecosystems, a unique demographic pattern analogous to repeating whole ecosystem treatment−control experiments. We found compelling examples indicating that in odd years, predation by pink salmon can initiate pelagic trophic cascades by reducing herbivorous zooplankton abundance sufficiently that phytoplankton densities increase, with opposite patterns in even years. Widespread interspecific competition for common-pool prey resources can be dominated by pink salmon, as indicated by numerous biennial patterns in the diet, growth, survival, abundance, age-at-maturation, distribution, and/or phenology of ecologically, culturally, and economically important forage fishes, squid, Pacific salmon and steelhead trout Oncorhynchus spp., seabirds, humpback whales Megaptera novaeangliae, and endangered southern resident killer whales Orcinus orca. In aggregate, the evidence indicates that open-ocean marine carrying capacity in the northern North Pacific Ocean and Bering Sea can be mediated by top-down forcing by pink salmon and by ocean heating, and that large-scale hatchery production ({\textasciitilde}40\% of the total adult and immature salmon biomass) likely has unintended consequences for wild salmon, including Chinook salmon O. tshawytscha, and many other marine species. Further investigation of the effects of pink salmon on other species will increase our knowledge of ecosystem function and the important role top-down forcing plays in the open ocean},
	journal = {Marine Ecology Progress Series},
	publisher = {Inter-Research Science Center},
	author = {Ruggerone, Gregory T. and Springer, Alan M. and van Vliet, Gus B. and Connors, Brendan and Irvine, James R. and Shaul, Leon D. and Sloat, Matthew R. and Atlas, William I.},
	year = {2023},
	keywords = {Climate change, Competition, Ecosystem services, Carrying capacity, North Pacific ecosystems, Ocean heating, Oncorhynchus gorbuscha, Trophic cascade},
	pages = {1--40},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\HL2THM9I\\m719p001.pdf:application/pdf},
}

