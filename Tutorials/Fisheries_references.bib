@article{Laskowski2016,
	title = {Behaviour in a standardized assay, but not metabolic or growth rate, predicts behavioural variation in an adult aquatic top predator \textit{{Esox} lucius} in the wild},
	volume = {88},
	copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
	issn = {0022-1112, 1095-8649},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/jfb.12933},
	doi = {10.1111/jfb.12933},
	abstract = {This study tested for links among behaviour, state and life‐history variables as predicted by the pace‐of‐life hypothesis in adult pike
              Esox lucius.
              First, a standardized open‐field behavioural assay was developed to assess individual behaviour of wild‐captured adult
              E. lucius
              . Behaviour within the standardized assay predicted swimming behaviour in the lake, providing an ecological validation of the assay. There was no relationship between standardized behaviour and any of the life‐history and state variables, including metabolism, body condition, juvenile growth rate and adult growth rate in contrast to predictions from the pace‐of‐life hypothesis. This study demonstrates that it is possible to assess ecologically relevant behavioural variation in a large‐bodied top predator using a standard open‐field assay, but it is noteworthy that this standardized behaviour is not systematically related to standard metabolism or growth.},
	language = {en},
	number = {4},
	urldate = {2026-04-20},
	journal = {Journal of Fish Biology},
	author = {Laskowski, K. L. and Monk, C. T. and Polverino, G. and Alós, J. and Nakayama, S. and Staaks, G. and Mehner, T. and Arlinghaus, R.},
	month = apr,
	year = {2016},
	keywords = {Acoustic telemetry, Behavioural type, Esox lucius, Field validation, Metabolism, Pace-of-life},
	pages = {1544--1563},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\FGCLQDMS\\Behaviour but not life-history predicts behavioural variation (Laskowski et al. 2016).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\8DDVJACI\\Laskowski et al. - 2016 - Behaviour in a standardized assay, but not metabolic or growth rate, predicts behavioural variation.pdf:application/pdf},
}

@article{Law2000,
	title = {Fishing, selection, and phenotypic evolution},
	volume = {57},
	issn = {10543139},
	url = {https://academic.oup.com/icesjms/article-lookup/doi/10.1006/jmsc.2000.0731},
	doi = {10.1006/jmsc.2000.0731},
	abstract = {Large changes are taking place in yield-determining traits of commercially exploited fish, including traits such as size-at-age and age-at-maturation. The cause of these phenotypic changes is often not understood, and genetic change arising from the selective effects of fishing may be a contributory factor. Selection generated by fishing gear is strong in heavily exploited fish stocks, and the spatial location of fishing can also cause strong selection. The success of selective breeding in aquaculture indicates that significant amounts of genetic variation for production-related traits exist in fish populations. Fisheries managers should be alert to the evolutionary change caused by fishing, because such changes are likely to be hard to reverse and, if properly controlled, could bring about an evolutionary gain in yield. (C) 2000 International Council for the Exploration of the Sea.},
	language = {en},
	number = {3},
	urldate = {2026-04-20},
	journal = {ICES Journal of Marine Science},
	author = {Law, R},
	month = jun,
	year = {2000},
	keywords = {Heritability, Growth rate, Age-at-maturation, Evolutionary effects of fishing, Phenotypic evolution, Selection caused by fishing, Sustainable yield},
	pages = {659--668},
