	keywords = {Gadus morhua, Maturation, Energy allocation, Fisheries-induced evolution, Geographical distribution, Life history strategy, Migration, State dependence},
	pages = {3436--3448},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\EN75G7LJ\\Evolution of spawning migrations.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\YNKH9UKZ\\Jørgensen et al. - 2008 - THE EVOLUTION OF SPAWNING MIGRATIONS STATE DEPENDENCE AND FISHING‐INDUCED CHANGES.pdf:application/pdf},
}

@article{Jørgensen2016,
	title = {Modelling and interpreting fish bioenergetics: a role for behaviour, life‐history traits and survival trade‐offs},
