	doi = {10.1046/j.1461-0248.2001.00182.x},
	abstract = {Models of source-sink population dynamics have to make assumptions about whether, and eventually how, demographic parameters in source habitats are dependent on demography in sink habitats. However, the empirical basis for making such assumptions has been weak. Here we report a study on experimental root vole populations, where estimate of demographic parameters were contrasted between source patches in source-sink (treatment) and source-source systems (control). In the presence of a sink patch (simulated by a pulsed removal of immigrants), source-patch populations failed to increase over the breeding season, mainly due to a high spatially density-dependent dispersal rate from source to sink patches. The \textit{per capita} recruitment rate was almost two times higher in source-sink than in the source-source system, but this did not compensate for the loss rate due to dispersal from source to sink patches. Sex ratio in the source-sink systems became less female biased, probably a result of an enhanced frequency of dispersal movements in femals. Good knowledge of the degree of density and habitat-dependent dispersal in critical for predicting the dynamics of source-sink populations.},
	number = {1},
	journal = {Ecology Letters},
	author = {Gundersen, G. and Johannesen, E. and Andreassen, H. P. and Ims, R. A.},
	year = {2001},
	keywords = {Demography, Dispersal, Experimental model system, Metapopulation, Microtus, Source-sink population},
	pages = {14--21},
	file = {Gundersen et al. - 2001 - Source-sink dynamics How sinks affect demography of sources 1.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Gundersen et al. - 2001 - Source-sink dynamics How sinks affect demography of sources 1.pdf:application/pdf},
