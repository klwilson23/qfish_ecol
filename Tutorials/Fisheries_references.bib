@article{Peterson2003,
	title = {Predicting the geography of species' invasions via ecological niche modeling.},
	volume = {78},
	issn = {0033-5770},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/14737826},
	abstract = {Species' invasions have long been regarded as enormously complex processes, so complex as to defy predictivity. Phases of this process, however, are emerging as highly predictable: the potential geographic course of an invasion can be anticipated with high precision based on the ecological niche characteristics of a species in its native geographic distributional area. This predictivity depends on the premise that ecological niches constitute long-term stable constraints on the potential geographic distributions of species, for which a sizeable body of evidence is accumulating. Hence, although the entire invasion process is indeed complex, the geographic course that invasions are able to take can be anticipated with considerable confidence.},
	number = {4},
	journal = {The Quarterly review of biology},
	author = {Peterson, A Townsend},
	year = {2003},
	keywords = {ecological niche models, geographic information systems, invasive species, niche evolution, predictive modeling},
	pages = {419--33},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\D3NJU78W\\Peterson_2003_QRB_Predictiong_sp_invasion_via_ENM.pdf:application/pdf;Peterson - 2003 - Predicting the geography of species' invasions via ecological niche modeling.pdf:C\:\\Users\\kylel\\Zotero\\storage\\ES4BAUSV\\C_Users_kylel_AppData_Local_Mendeley Ltd._Mendeley Desktop_Downloaded_Peterson - 2003 - Predicting the geography of species' invasions via ecological niche modeling.pdf:application/pdf},
