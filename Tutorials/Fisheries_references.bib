@article{yeakel_synchronisation_2014-1,
	title = {Synchronisation and stability in river metapopulation networks},
	volume = {17},
	issn = {14610248},
	doi = {10.1111/ele.12228},
	abstract = {Spatial structure in landscapes impacts population stability. Two linked components of stability have large consequences for persistence: first, statistical stability as the lack of temporal fluctuations; second, synchronisation as an aspect of dynamic stability, which erodes metapopulation rescue effects. Here, we determine the influence of river network structure on the stability of riverine metapopulations. We introduce an approach that converts river networks to metapopulation networks, and analytically show how fluctuation magnitude is influenced by interaction structure. We show that river metapopulation complexity (in terms of branching prevalence) has nonlinear dampening effects on population fluctuations, and can also buffer against synchronisation. We conclude by showing that river transects generally increase synchronisation, while the spatial scale of interaction has nonlinear effects on synchronised dynamics. Our results indicate that this dual stability - conferred by fluctuation and synchronisation dampening - emerges from interaction structure in rivers, and this may strongly influence the persistence of river metapopulations.},
	number = {3},
	journal = {Ecology Letters},
	author = {Yeakel, Justin D. and Moore, Jonathan W. and Guimarães, P. R. and de Aguiar, M. A.M.},
	year = {2014},
	keywords = {Fluctuations, Metapopulations, River networks, Stability, Synchronisation},
	pages = {273--283},
	file = {Yeakel et al. - 2014 - Synchronisation and stability in river metapopulation networks 14.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Yeakel et al. - 2014 - Synchronisation and stability in river metapopulation networks 14.pdf:application/pdf},
}

@misc{ingeman_ocean_2019,
	title = {Ocean recoveries for tomorrow's {Earth}: {Hitting} a moving target},
	doi = {10.1126/science.aav1004},
	abstract = {Growing scientific awareness, strong regulations, and effective management have begun to fulfill the promise of recovery in the ocean. However, many efforts toward ocean recovery remain unsuccessful, in part because marine ecosystems and the human societies that depend upon them are constantly changing. Furthermore, recovery efforts are embedded in marine social-ecological systems where large-scale dynamics can inhibit recovery. We argue that the ways forward are to (i) rethink an inclusive definition of recovery that embraces a diversity of stakeholder perspectives about acceptable recovery goals and ecosystem outcomes; (ii) encourage research that enables anticipation of feasible recovery states and identifies pathways toward resilient ecosystems; and (iii) adopt policies that are sufficiently nimble to keep pace with rapid change and governance that works seamlessly from local to regional scales. Application of these principles can facilitate successful recoveries in a world where environmental conditions and social imperatives are constantly shifting.},
	publisher = {American Association for the Advancement of Science},
	author = {Ingeman, Kurt E. and Samhouri, Jameal F. and Stier, Adrian C.},
	month = jan,
	year = {2019},
	pmid = {30679339},
	note = {ISSN: 10959203
Issue: 6425
Publication Title: Science
Volume: 363},
}

