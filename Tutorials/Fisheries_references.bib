	publisher = {Academic Press},
	author = {Sanchirico, James N. and Wilen, James E.},
	month = jul,
	year = {2005},
	keywords = {Fisheries management, Spatial management, Metapopulation, Zoning, Price instruments},
	pages = {23--46},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\YWL5P6JI\\Spatial model of marine fisheries (Sanchirico and Wilen 2005).pdf:application/pdf;Sanchirico and Wilen - 2005 - Optimal spatial management of renewable resources matching policy scope to ecosystem scale 16.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Sanchirico and Wilen - 2005 - Optimal spatial management of renewable resources matching policy scope to ecosystem scale 16.pdf:application/pdf},
