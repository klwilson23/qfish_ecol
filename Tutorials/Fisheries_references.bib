@article{Howey2011,
	title = {Multiple pathways across past landscapes: circuit theory as a complementary geospatial method to least cost path for modeling past movement},
	volume = {38},
	issn = {03054403},
	shorttitle = {Multiple pathways across past landscapes},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0305440311001099},
	doi = {10.1016/j.jas.2011.03.024},
	abstract = {The incorporation of geospatial technologies in archaeology has resulted in productive advances in the analysis of past behavioral processes. Archaeologists have relied on the Geographic Information Systems (GIS) application of cost surface analysis and the computation of least cost paths (LCP) to study movement, one key social process. Recent research has identiﬁed limitations with LCP for modeling nonhuman species movement, notably the inability of LCP to accommodate multiple pathways. Archaeology must consider the implications of these critiques for models of past human movement. In this paper, I apply a different approach, circuit theory modeling, enacted through the program Circuitscape, to an archaeological case study previously analyzed with LCP modeling, travel to a regionally signiﬁcant ceremonial earthwork center during Late Prehistory (ca. AD 1200e1600) in the Northern Great Lakes. Through this comparative analysis, I evaluate the advantages and disadvantages of these methods for modeling past movement. The results suggest LCP modeling and circuit modeling offer archaeology complementary geospatial methods for conceptualizing past mobility. Combining circuit theory and LCP allows archaeologists to produce richer models of past movement by appreciating scenarios where multiple pathways are important as well as scenarios where optimum single travel routes have priority.},
	language = {en},
	number = {10},
	urldate = {2026-04-20},
	journal = {Journal of Archaeological Science},
	publisher = {Elsevier Ltd},
	author = {Howey, Meghan C.L.},
	month = oct,
	year = {2011},
	keywords = {Movement, Circuitscape, Geospatial technologies, GIS, Great Lakes, Late prehistory, Past Landscapes},
	pages = {2523--2535},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\CNPHKUWX\\Circuit theory as a geospatial method to model past human movements (Howey 2011).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\DT3983J7\\Howey - 2011 - Multiple pathways across past landscapes circuit theory as a complementary geospatial method to lea.pdf:application/pdf},
}

@article{Hunsicker2011,
	title = {Functional responses and scaling in predator-prey interactions of marine fishes: contemporary issues and emerging concepts: {Predator}-prey interactions in marine systemsis},
	volume = {14},
	copyright = {http://doi.wiley.com/10.1002/tdm\_license\_1.1},
	issn = {1461023X},
	shorttitle = {Functional responses and scaling in predator-prey interactions of marine fishes},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/j.1461-0248.2011.01696.x},
	doi = {10.1111/j.1461-0248.2011.01696.x},
	abstract = {Predator–prey interactions are a primary structuring force vital to the resilience of marine communities and sustainability of the worldÕs oceans. Human inﬂuences on marine ecosystems mediate changes in species interactions. This generality is evinced by the cascading effects of overharvesting top predators on the structure and function of marine ecosystems. It follows that ecological forecasting, ecosystem management, and marine spatial planning require a better understanding of food web relationships. Characterising and scaling predator–prey interactions for use in tactical and strategic tools (i.e. multi-species management and ecosystem models) are paramount in this effort. Here, we explore what issues are involved and must be considered to advance the use of predator–prey theory in the context of marine ﬁsheries science. We address pertinent contemporary ecological issues including (1) the approaches and complexities of evaluating predator responses in marine systems; (2) the Ôscaling upÕ of predator–prey interactions to the population, community, and ecosystem level; (3) the role of predator–prey theory in contemporary ﬁsheries and ecosystem modelling approaches; and (4) directions for the future. Our intent is to point out needed research directions that will improve our understanding of predator–prey interactions in the context of the sustainable marine ﬁsheries and ecosystem management.},
	language = {en},
	number = {12},
	urldate = {2026-04-20},
	journal = {Ecology Letters},
	author = {Hunsicker, Mary E. and Ciannelli, Lorenzo and Bailey, Kevin M. and Buckel, Jeffrey A. and Wilson White, J. and Link, Jason S. and Essington, Timothy E. and Gaichas, Sarah and Anderson, Todd W. and Brodeur, Richard D. and Chan, Kung-Sik and Chen, Kun and Englund, Göran and Frank, Kenneth T. and Freitas, Vânia and Hixon, Mark A. and Hurst, Thomas and Johnson, Darren W. and Kitchell, James F. and Reese, Doug and Rose, George A. and Sjodin, Henrik and Sydeman, William J. and Van Der Veer, Henk W. and Vollset, Knut and Zador, Stephani},
	month = dec,
	year = {2011},
	keywords = {Predation, Population regulation, Ecosystem models, Individual-based models, Marine fisheries, Multi-species model, Predator responses, Scaling},
	pages = {1288--1299},
	file = {Hunsicker et al. - 2011 - Functional responses and scaling in predator-prey interactions of marine fishes contemporary issues 13.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Hunsicker et al. - 2011 - Functional responses and scaling in predator-prey interactions of marine fishes contemporary issues 13.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\3NIA3XUX\\Functional responses and scaling in predator-prey interactions.pdf:application/pdf},
}

@article{Hunt2005,
	title = {Recreational {Fishing} {Site} {Choice} {Models}: {Insights} and {Future} {Opportunities}},
	volume = {10},
	issn = {1087-1209, 1533-158X},
	shorttitle = {Recreational {Fishing} {Site} {Choice} {Models}},
	url = {http://www.tandfonline.com/doi/abs/10.1080/10871200591003409},
	doi = {10.1080/10871200591003409},
	abstract = {This article reviews published research that has focused on the recreational fishing site choices made by anglers. A conceptual model for predicting fishing site choice is developed by synthesizing the findings from past studies that employed fishing site choice models. From these and other relevant studies, six general attributes (i.e., costs, fishing quality, environmental quality, facility development, encounters with other anglers, and regulations) are identified that may influence an angler’s selection of a fishing site. The article also enhances the conceptual model by accounting for differing preferences among anglers, for complex substitution patterns among fishing sites, for fishing participation decisions, for habit forming behaviors and for differences in anglers’ awareness levels for fishing sites. Finally, the article discusses several avenues that researchers could exploit to improve on past fishing site choice model studies.},
	language = {en},
	number = {3},
	urldate = {2026-04-20},
	journal = {Human Dimensions of Wildlife},
	author = {Hunt, Len M.},
	month = oct,
	year = {2005},
	note = {ISBN: 1087120059100},
	keywords = {Recreational fishing, Choice modeling, Participation, Review, Site choice, Site substitution},
	pages = {153--172},
	file = {Choice models compared to gravity models in recreational fishing (Hunt 1999).pdf:C\:\\Users\\kylel\\Zotero\\storage\\B6ZDHWBZ\\Choice models compared to gravity models in recreational fishing (Hunt 1999).pdf:application/pdf;Hunt - 2005 - Recreational Fishing Site Choice Models Insights and Future Opportunities 33.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Hunt - 2005 - Recreational Fishing Site Choice Models Insights and Future Opportunities 33.pdf:application/pdf;Hunt - 2005 - Recreational Fishing Site Choice Models Insights and Future Opportunities 34.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Hunt - 2005 - Recreational Fishing Site Choice Models Insights and Future Opportunities 34.pdf:application/pdf;Hunt 2005.pdf:C\:\\Users\\kylel\\Zotero\\storage\\3U55TVFQ\\Hunt 2005.pdf:application/pdf},
