@article{Carabott2017,
	title = {Fifty years on},
	volume = {366},
	doi = {10.4324/9781315239309-1},
	abstract = {Unsurprisingly perhaps, coming to terms with the cycle of blood that the fratricidal struggle unleashed has been an arduous process. For those who experienced the conflict at first hand, its hardships, the passions it evoked and the ideals around which it was fought, the process has tended to remain incomplete. Both sides have constructed their own opposing - Machiavellian and Manichean alike - narratives of the era, apportioned blame to adversaries and their foreign patrons, and, in the case of the victors, sought to safeguard the spoils of their 'triumph' by discriminating against the vanquished. Fifty years on, the lean and sterile Gold War accounts of the civil war, with their unashamedly polemical and partisan underpinnings, their subscription to the 'good vs. evil' moral cliche, and their castigation of one side and vindication of the other, have been replaced by a burgeoning corpus of works on Greece of the 1940s.},
	journal = {The Greek Civil War: Essays on a Conflict of Exceptionalism and Silences},
	author = {Carabott, Philip and Sfikas, Thanasis D.},
	year = {2017},
	note = {ISBN: 9781351888653},
	keywords = {population dynamics, sheries regulation, simulations, whaling},
