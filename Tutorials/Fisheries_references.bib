}

@article{Law2005,
	title = {Human-induced dwarfing of {Himalayan} snow lotus, \textit{{Saussurea} laniceps} ({Asteraceae})},
	volume = {102},
	issn = {0027-8424, 1091-6490},
	url = {https://pnas.org/doi/full/10.1073/pnas.0502931102},
	doi = {10.1073/pnas.0502931102},
	abstract = {Because evolutionary processes such as genetic drift and natural selection play a crucial role in determining the response that species will have to human-induced disturbances, there is increasing interest in the evolutionary aspects of conservation biology. Harvesting select individuals in natural plant populations can bring about unforeseen impacts that may negatively affect fitness. We analyzed how human harvesting affects two congeners known as snow lotus. Over a period of 100 years, there was a negative trend in plant height (
              r
              2
              = 0.4361,
              P
              {\textless} 0.001) for the intensely collected and rare species,
              Saussurea laniceps
              , but not in the less intensely collected species,
              Saussurea medusa
              . Additionally,
              S. laniceps
              were significantly smaller in areas of high harvest than in areas with low harvest (
              Z
              = 4.91,
              P
              {\textless} 0.0001), but this was not so for
              S. medusa
              . Humans can unconsciously drive evolution and must be considered when managing threatened species.},
	language = {en},
	number = {29},
	urldate = {2026-04-20},
	journal = {Proceedings of the National Academy of Sciences},
	author = {Law, Wayne and Salick, Jan},
	month = jul,
	year = {2005},
	pages = {10218--10220},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\SCQ9AKYC\\Evolution of plant lotus to harvest (Law and Salick 2005).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\MY4VQKWI\\Law and Salick - 2005 - Human-induced dwarfing of Himalayan snow lotus, Saussurea laniceps (Asteraceae).pdf:application/pdf},
}

