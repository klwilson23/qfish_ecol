	file = {Berkes - 2010 - Devolution of environment and resources governance.pdf:C\:\\Users\\kylel\\Zotero\\storage\\HLFZFEG2\\Berkes - 2010 - Devolution of environment and resources governance.pdf:application/pdf},
}

