@article{ludwig1981a,
	title = {Measurement {Errors} and {Uncertainty} in {Parameter} {Estimates} for {Stock} and {Recruitment}},
	volume = {38},
	copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
