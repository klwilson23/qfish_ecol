@article{Unmuth2000,
	title = {Influence of {Dense} {Growth} of {Eurasian} {Watermilfoil} on {Lake} {Water} {Temperature} and {Dissolved} {Oxygen}},
	volume = {15},
	issn = {0270-5060, 2156-6941},
	url = {http://www.tandfonline.com/doi/abs/10.1080/02705060.2000.9663772},
	doi = {10.1080/02705060.2000.9663772},
	abstract = {Over a five year period we compared summer temperature and dissolved oxygen (DO) at 10 sites within dense beds of Myriophyllum spicatum L. to an unvegetated reference site in a moderately eutrophic Wisconsin lake. Average surface temperatures in the Eurasian watermilfoil beds were significantly elevated in two of the five years, while bottom temperatures were significantly depressed each year. Dissolved oxygen concentrations in surface layers of the bed were elevated by at least 1 mg L-1 during roughly 30-40\% of site-date visits, while DOs in the bottom layers were depressed on the average more than 50\% of monitoring visits. Both depressed DOs and low DOs ({\textless} 3.0 mg L (-1)) in bottom layers were positively correlated with average annual air temperatures but were not directly related to variations in milfoil biomass. Dissolved oxygen and temperature appeared to be most severely impacted at shallow, densely vegetated sites close to shore.},
	language = {en},
	number = {4},
	urldate = {2026-04-20},
	journal = {Journal of Freshwater Ecology},
	author = {Unmuth, Jean M. L. and Lillie, Richard A. and Dreikosen, David S. and Marshall, David W.},
	month = dec,
	year = {2000},
	pages = {497--503},
	file = {Macrophyte DO issues.pdf:C\:\\Users\\kylel\\Zotero\\storage\\X3A38T8M\\Macrophyte DO issues.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\UMQKMDYT\\Unmuth et al. - 2000 - Influence of Dense Growth of Eurasian Watermilfoil on Lake Water Temperature and Dissolved Oxygen.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\QDYU4HF6\\Unmuth et al. - 2000 - Influence of Dense Growth of Eurasian Watermilfoil on Lake Water Temperature and Dissolved Oxygen.pdf:application/pdf;Plants\; Dense SAV on DO Dynamics (Unmuth et al. 2000).pdf:C\:\\Users\\kylel\\Zotero\\storage\\PIMWM7NR\\Plants\; Dense SAV on DO Dynamics (Unmuth et al. 2000).pdf:application/pdf},
