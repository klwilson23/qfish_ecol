@article{Bates2009,
	title = {Mixed models in {R} using the lme4 package {Part} 3: {Longitudinal} data},
	abstract = {A transition matrix growth and an ingrowth model were developed and applied to an uneven-aged mixed-species forest in the Changbai Mountains, northeastern of China, that can be used for selecting optimal forest management strategies. Results indicate that the constant-parameter transition probabilities for all species in the mixed uneven-aged forest could be classified into 3 groups based on the mean upgrowth probabilities of each species: (1) Manchurian ash (Fraxinus mandshurica), walnut (Juglans regia), Mongolian oak (Quercus mongolica) and poplar (Populus) have largest upgrowth probabilities (0.36775); (2) birch (Betula), amur linder (Tilia amurensis) and other species (0.26681); and (3) ash-leaved maple [Acer negundo], elm (Ulmus) and amur cocktree (Phellodendron amurense) having the smallest upgrowth probability (0.17185). Constant-parameter transition probabilities of all species in each diameter class fluctuate within a narrow range except for diameter classes below 8 cm and greater than 60 cm. Variable-parameter transition probabilities were found to be a function of residual basal area for small diameter classes. For large trees, transition probabilities are not affected by the residual basal area. Based on this study, variable-parameter transition probabilities for large diameter trees can be replaced with constant-parameter transition probabilities. In addition, a new ingrowth model was developed and was shown to perform better than existing ingrowth model used in the region.{\textbackslash}n},
	author = {Bates, Douglas M.},
	year = {2009},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\CKEHCAPD\\bates nonlinear mixed models in R.pdf:application/pdf},
}

