@article{forrest_non-stationarity_2026,
	title = {Non-stationarity in population parameters requires careful interpretation of equilibrium reference points},
	volume = {83},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {1054-3139, 1095-9289},
	url = {https://academic.oup.com/icesjms/article/doi/10.1093/icesjms/fsag181/8859185},
	doi = {10.1093/icesjms/fsag181},
	abstract = {A key reference point in fisheries management is the limit reference point (LRP), which represents a biomass threshold below which serious harm to the fish population is believed to occur. Reference points are often based on equilibrium quantities such as unfished spawning biomass (SB0) or spawning biomass at maximum sustainable yield (SBMSY), which are calculated using parameters that are assumed constant over time. When equilibrium assumptions are not met within a stock assessment (e.g., when natural mortality (M) is changing over time), there is a question of how to define reference points, especially when changes in productivity parameters cause reference points to change in scale. In this study, we develop simulation models based on recent stock assessments for three Pacific herring (Clupea pallasii) stocks for which M is estimated to have increased on average over the past 50 years. We explore relationships between M, SB0 and stock-recruit parameters under typical assumptions used in stock assessments. We pose two questions: (1) Are equilibrium-based reference points meaningful for Pacific herring stocks when productivity is changing rapidly? and (2) How do different derivations of the LRP impact perceptions of stock status and the relationship of the LRP to serious harm thresholds? We show that when productivity is changing rapidly, the calculation of SB0 using typical analytical approaches can violate equilibrium assumptions. Moreover, when M is increasing, the strong negative relationship between M and SB0 means that LRPs based on dynamic recent values of M can be substantially lower than LRPs based on historical or long-term average values M. Allowing LRP thresholds to decrease with increasing M results in more optimistic assessments of stock status and potentially allows LRPs to drop to levels below serious harm thresholds. We invite practitioners to take a more thoughtful approach to the question of whether LRPs should be lowered in the presence of increasing natural mortality.},
	language = {en},
	number = {10},
	urldate = {2026-10-05},
	journal = {ICES Journal of Marine Science},
	author = {Forrest, Robyn E and Huynh, Quang C and Hordyk, Adrian R},
	editor = {Sun, Ming},
	month = oct,
	year = {2026},
	pages = {fsag181},
	file = {Forrest et al. - 2026 - Non-stationarity in population parameters requires careful interpretation of equilibrium reference p.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Forrest et al. - 2026 - Non-stationarity in population parameters requires careful interpretation of equilibrium reference p.pdf:application/pdf},
}

@article{gomes_widespread_2026,
	title = {Widespread marine mammal and seabird reductions are unlikely to benefit salmon due to indirect ecosystem effects},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.aeb1122},
	doi = {10.1126/science.aeb1122},
	abstract = {Pacific salmon are depleted due to anthropogenic impacts, and populations have failed to recover despite management interventions. Predation on salmon by pinnipeds and seabirds has been suggested as a barrier to recovery, leading to calls for predator culls by some. However, no studies have evaluated the whole-ecosystem impact of removing these predators nor estimated the direct and indirect effects of these culls on salmon. We use an end-to-end ecosystem model to assess the efficacy of widespread culls in marine environments. We find that culls are unlikely to benefit salmon due to the indirect food web effects of predator reduction and the low biomass of top predator groups. Instead, more abundant fish predators, northward-expanding competitors, and temperature-sensitive prey have larger effects on salmon in the ocean.},
	language = {en},
	urldate = {2026-11-25},
	journal = {Science},
	author = {Gomes, Dylan G. E. and Crozier, Lisa G. and Ruzicka, James J. and Huff, David D. and Stewart, Joshua D.},
	month = nov,
	year = {2026},
	pages = {eaeb1122},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\Y66T9EU5\\Gomes et al. - 2026 - Widespread marine mammal and seabird reductions are unlikely to benefit salmon due to indirect ecosy.pdf:application/pdf},
}

@article{wilson_groundfish_2026,
	title = {Groundfish {With} {Diverse} {Life} {Histories} {Increase} in {Size} and {Abundance} {With} {Proximity} to {Spatial} {Protections}},
	volume = {29},
	issn = {1461-023X, 1461-0248},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ele.70486},
	doi = {10.1111/ele.70486},
	abstract = {Detecting positive responses to marine spatial protections, both in situ and as spillover effects, is critical for fisheries management yet difficult in practice. We leveraged 18 years of data on 28 groundfish species, collected by four Indigenous Nations in Pacific Canada, to assess ecological responses inside and up to 160 km outside spatially protected Rockfish Conservation Areas (RCAs). Body sizes and abundances were greatest inside RCAs and increased with proximity to RCAs. Abundance responses emerged faster (at younger RCA ages) for species with high rmax, as predicted, but body size responses emerged faster for species with low rmax, counter to predictions. Our study illustrates a general framework for jointly inferring in situ recovery and spillover benefits using a novel hierarchical geostatistical model that integrated long time series; observations made inside, near, and far from seven RCAs; and multiple species and survey methods spanning a 500-m depth range.},
	language = {en},
	number = {11},
	urldate = {2026-11-25},
	journal = {Ecology Letters},
	author = {Wilson, Kyle L. and Frid, Alejandro and Anderson, Sean C.},
	month = nov,
	year = {2026},
	pages = {e70486},
	file = {Wilson et al. - 2026 - Groundfish With Diverse Life Histories Increase in Size and Abundance With Proximity to Spatial Prot.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Wilson et al. - 2026 - Groundfish With Diverse Life Histories Increase in Size and Abundance With Proximity to Spatial Prot.pdf:application/pdf},
}

@article{thompson_canadas_2026,
	title = {Canada's {Species} at {Risk} {Act}: listing lags and limbos},
	volume = {11},
	issn = {2371-1671},
	shorttitle = {Canada's {Species} at {Risk} {Act}},
	url = {https://facetsjournal.com/doi/10.1139/facets-2026-0031},
	doi = {10.1139/facets-2026-0031},
	abstract = {Canada’s Species at Risk Act (SARA) aims to prevent wildlife extinction and facilitate the recovery and management of species imperilled due to human activity. A species may only be included on SARA after scientiﬁc assessment and a Cabinet decision. Recommended timelines for each stage of this process were introduced in 2017. We evaluated the inﬂuence of these recommendations by comparing delays before and after 2017, focusing speciﬁcally on the second stage where timelines are not mandatory. We also analyzed stated causes of delay for each species considered for listing. We found that decisions were made within the timeframe for only 6\% of 288 species, and 31\% were listed after delays. Critically, 85\% of 181 species waiting for a decision have already exceeded recommended timelines. Timeline compliance did not improve after the 2017 policy was introduced (longer median decision times and proportionally fewer species advanced to decision), where decisions exceeded the timelines by an average of 477 days (versus 484 days pre-2017). Certain species groups, particularly marine vertebrates, experienced disproportionate delays, but publicly available information highlighting causes of delays is limited. Despite the intention of the 2017 policy to expedite decision-making, species at risk in Canada continue to wait.},
	language = {en},
	urldate = {2026-11-25},
	journal = {FACETS},
	author = {Thompson, Peter R. and Tissier, Mathilde L. and Lewthwaite, Jayme M.M. and Cannon, Sara E. and Lopez, Mark Louie D. and Menzies, Allyson K. and Perron, Mary Ann C. and Piczak, Morgan L. and Vanderwolf, Karen and Schiller, Laurenne and Bugg, William S. and Bohn, Shelby J. and Palen, Wendy J. and Ray, Justina C. and Otto, Sarah P.},
	editor = {Olive, Andrea and Joly, Yann},
	month = jan,
	year = {2026},
	pages = {1--14},
	file = {Thompson et al. - 2026 - Canada's Species at Risk Act listing lags and limbos.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Thompson et al. - 2026 - Canada's Species at Risk Act listing lags and limbos.pdf:application/pdf},
}

@article{beveridge_what_2026,
	title = {What does priority mean in a context of decreasing abundance? {Upholding} {Nuxalk} salmon rights},
	volume = {11},
	issn = {2371-1671},
	shorttitle = {What does priority mean in a context of decreasing abundance?},
	url = {https://facetsjournal.com/doi/10.1139/facets-2025-0427},
	doi = {10.1139/facets-2025-0427},
	abstract = {Along the coast of what is known as British Columbia, Canada, First Nations face persistent legal, regulatory, and environmental challenges which affect the ﬁsheries on which they depend. Over the past decades, cumulative impacts——including colonial management practices——have drastically reduced coastal First Nations’ access to salmon (Oncorhynchus spp.). This is so despite legal recognition of First Nations’ constitutionally protected rights to ﬁsh. Here, we combine data from health and ﬁsheries sciences to question what priority means——and to whom——in a context of low or unreliable salmon abundance. Focusing on sockeye and Chinook salmon destined for the traditional territory of the Nuxalk Nation, we describe three potential operationalisations of “enough”, considering rightful harvest in terms of amount, abundance, and allocation. For each, we consider how even a minimal deﬁnition of Nuxalk ﬁshing rights has been upheld, and how these rights are experienced on the ground. We ﬁnd that despite salmon protection and recovery efforts (including those led by First Nations), Nuxalk ﬁshers have poor salmon access. This suggests that the implementation of the federal Salmon Allocation Policy has not led to alignment with the federal Doctrine of Priority, UNDRIP, nor broader ﬁsheries reconciliation efforts.},
	language = {en},
	urldate = {2026-11-25},
	journal = {FACETS},
	author = {Beveridge, Rachelle and Gavenus, Erika and Wilson, Kyle L. and Steel, Jade and Atlas, Will and Pootlass, Rainwater and Satterfield, Terre},
	editor = {Olive, Andrea and Wiebe, Sarah Marie},
	month = jan,
	year = {2026},
	pages = {1--20},
	file = {Beveridge et al. - 2026 - What does priority mean in a context of decreasing abundance Upholding Nuxalk salmon rights.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Beveridge et al. - 2026 - What does priority mean in a context of decreasing abundance Upholding Nuxalk salmon rights.pdf:application/pdf},
