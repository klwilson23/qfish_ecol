	pages = {2388--2400},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\V9C3EVXN\\Lambert and Dutil - 1997 - Condition and energy reserves of Atlantic cod ( Gadus morhua ) during the collapse of the nor.pdf:application/pdf},
