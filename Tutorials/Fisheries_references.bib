@article{Kaemingk2018,
	title = {Synchrony — {An} emergent property of recreational fisheries},
	volume = {55},
	issn = {0021-8901, 1365-2664},
	url = {https://besjournals.onlinelibrary.wiley.com/doi/10.1111/1365-2664.13164},
	doi = {10.1111/1365-2664.13164},
	abstract = {Abstract
            
              
                
                  Recreational fisheries are traditionally managed at local scales, but more effective management could be achieved using a cross‐scale approach. To do this, we must first understand how local processes scale up to influence landscape patterns between anglers and resources. We highlight how population‐based synchrony methods, used in conjunction with a complex‐adaptive‐systems framework, can reveal emergent spatial properties within social‐ecological systems such as recreational fisheries.
                
                
                  
                    Herein, we quantified the level of spatial synchrony in angler behaviour, defined the relationship between angler synchrony and distance among waterbodies, and highlighted social‐ecological attributes contributing to these patterns. We leveraged a 111 waterbody‐year (34 waterbodies, 5‐year collection period) recreational fisheries dataset from Nebraska,
                    USA
                    to address these objectives.
                  
                
                
                  Intra‐annual patterns in angler behaviour were moderately synchronous across large spatial scales and predominately unrelated to distance among waterbodies. Large‐scale synchronous patterns in angler behaviour emerged from local‐scale interactions between angler heterogeneity and waterbody diversity.
                
                
                  Spatial synchrony in angler behaviour is an emergent property that resulted from local‐level processes that scaled up to form large‐scale patterns. We posit that angler utility in combination with waterbodies sharing these desired utility components caused spatial synchrony among anglers with similar preferences or specializations. The level of spatial synchrony in angler behaviour will therefore depend on the degree of angler heterogeneity and waterbody diversity on the landscape, with high or low levels of both leading to low and high levels of spatial synchrony respectively.
                
                
                  
                    Synthesis and applications
                    . Synchrony‐based methods proved useful for unveiling an emergent property in recreational fisheries that is beneficial for effective cross‐scale management. It may not be appropriate to extrapolate information and apply uniform management actions among local waterbodies because angler behaviour was not synchronous at small scales. Rather, anglers respond uniquely to waterbody diversity and therefore substitute waterbodies may be dispersed throughout the landscape. Creating boat access, for example could yield unintended consequences for a particular angler group and cause local and regional shifts in angler behaviour. Evaluating appropriate management options will require a cross‐scale monitoring approach that captures angler heterogeneity and waterbody diversity at multiple scales.
                  
                
              
            
          , 
            Foreign Language Abstract Resumen
            
              
              
                
                  
                    La pesca recreativa se administra tradicionalmente a escala local, pero se podría lograr una administración más eficaz utilizando un enfoque a través de escalas cruzadas. Para hacer esto, primero debemos entender cómo los procesos locales se han ampliado para influir los modelos panorámicos entre los pescadores y los recursos. Destacamos cómo los métodos de sincronía basados ​​en la población, usados en conjunto con un sistema estructural adaptativo complejo, pueden revelar propiedades espaciales emergentes dentro de sistemas socio‐ecológicos tales como la pesca recreativa.
                  
                  
                    Aquí, cuantificamos el nivel de sincronización espacial en el comportamiento del pescador, definimos la relación entre la sincronía del pescador y la distancia de las masas de agua y resaltamos las características sociales y ecológicas que contribuyen a estos modelos. Para abordar en estos objetivos hemos aprovechado un conjunto de datos de un estudio de 111 años (que contiene 34 cuerpos fluviales, en un periodo de colección de 5 años) sobre la pesca recreativa en el estado de Nebraska, EE. UU.
                  
                  
                    Los patrones intra‐anuales en el comportamiento del pescador fueron moderadamente sincrónicos a través de grandes escalas espaciales y sin relación predominante con la distancia entre las masas de agua. Los patrones síncronos a gran escala en el comportamiento del pescador surgieron a partir de las interacciones a escala local entre la heterogeneidad del pescador y la diversidad del cuerpo de agua.
                  
                  
                    La sincronía espacial en el comportamiento del pescador es una propiedad emergente que es resultado de los procesos a nivel local que se han ampliado para formar patrones en gran escala. Postulamos que la utilidad del pescador en combinación con los cuerpos de agua que comparten estos componentes de utilidad deseados causó una sincronía espacial entre los pescadores con preferencias o especializaciones similares. Por lo tanto, el nivel de sincronía espacial en el comportamiento del pescador dependerá del grado de heterogeneidad del pescador y la diversidad del cuerpo de agua en el panorama, con niveles altos o bajos de ambos que conducen a niveles bajos y altos de sincronía espacial, respectivamente.
                  
                  
                    
                      Síntesis y aplicaciones
                      . Los métodos basados en sincronía demostraron ser eficientes en descubrir una propiedad emergente en la pesca recreativa que es beneficiosa para el manejo efectivo a través de las escalas cruzadas. No sería apropiado extrapolar información y aplicar un manejo de acciones uniformes entre los cuerpos de agua locales porque el comportamiento del pescador no fue sincrónico en escalas menores. Más bien, los pescadores responden singularmente a la diversidad de los cuerpos de agua y por consiguiente los cuerpos de agua substitutos pueden estar dispersados por todo el panorama. Por ejemplo, el crear acceso para embarcaciones puede producir consecuencias imprevistas para un grupo de pescadores particular causando cambios en comportamiento locales y regionales. La evaluación de las opciones de manejos apropiados requerirá un enfoque de monitoreo a través de las escalas que capturen la heterogeneidad del pescador y la diversidad de los cuerpos de agua en múltiples escalas.
                    
                  
                
              
            
          , 
            Synchrony‐based methods proved useful for unveiling an emergent property in recreational fisheries that is beneficial for effective cross‐scale management. It may not be appropriate to extrapolate information and apply uniform management actions among local waterbodies because angler behaviour was not synchronous at small scales. Rather, anglers respond uniquely to waterbody diversity and therefore substitute waterbodies may be dispersed throughout the landscape. Creating boat access, for example could yield unintended consequences for a particular angler group and cause local and regional shifts in angler behaviour. Evaluating appropriate management options will require a cross‐scale monitoring approach that captures angler heterogeneity and waterbody diversity at multiple scales.},
	language = {en},
	number = {6},
	urldate = {2026-04-20},
	journal = {Journal of Applied Ecology},
	author = {Kaemingk, Mark A. and Chizinski, Christopher J. and Hurley, Keith L. and Pope, Kevin L.},
	editor = {Arlinghaus, Robert},
	month = nov,
	year = {2018},
	keywords = {fisheries, complex adaptive systems, cross-scale interactions, emergent properties, social-ecological systems, spatial and temporal dynamics, synchrony, waterbody and angler diversity},
	pages = {2986--2996},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\SPKDN5VT\\Synchrony as emergent property of recreational fisheries (Kaemingk et al. 2018).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\BPX4RHS8\\Kaemingk et al. - 2018 - Synchrony — An emergent property of recreational fisheries.pdf:application/pdf},
}

@article{Kaemingk2019,
