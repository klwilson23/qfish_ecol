	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\ECWZHH4Z\\Cowen, Paris, Srinivasan - 2006 - Scaling of connectivity in marine populations.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\TJ7WADVK\\Cowen et al. - 2006 - Scaling of Connectivity in Marine Populations.pdf:application/pdf},
