@article{qiao_spatial_2022-1,
	title = {Spatial asynchrony matters more than alpha stability in stabilizing ecosystem productivity in a large temperate forest region},
	issn = {1466-8238},
	url = {https://onlinelibrary.wiley.com/doi/full/10.1111/geb.13488 https://onlinelibrary.wiley.com/doi/abs/10.1111/geb.13488 https://onlinelibrary.wiley.com/doi/10.1111/geb.13488},
	doi = {10.1111/GEB.13488},
	abstract = {Aim: Understanding the biodiversity–stability relationship has become a central issue in ecology and conservation biology. Although the stabilizing effects of tree species diversity on ecosystem productivity are well recorded in small local communities, they remain poorly understood across scales (from local to larger spatial scales). This study evaluates biodiversity–stability effects from local to larger spatial scales in a large temperate forest region, considering a range of environmental conditions and environmental heterogeneity. Location: North-eastern China (c. 700,000 km2). Time period: 2005–2017. Major taxa studied: Woody plants. Methods: We define stability as the temporal invariability of biomass productivity. Regional metacommunities representing larger spatial scales were developed by aggregating multiple sets of local field plots. Simple regression analysis was used to test biodiversity–stability relationships in metacommunities. Piecewise structural equation modelling was then used to disentangle the effects of diversity and abiotic variables on forest stability at local and larger spatial scales. Multiple mixed-effects regression models were used to determine the relative contribution of individual predictive variables to stability across spatial scales. Results: We found that local diversity (alpha diversity) was positively related to the stability of local communities (alpha stability), whereas species turnover across space (beta diversity) was positively related to asynchronous dynamics among local communities (spatial asynchrony), regardless of whether abiotic factors were considered or not. We also found that environmental conditions and environmental heterogeneity affected forest stability across scales. The effect of spatial asynchrony on gamma stability was greater than that of alpha stability. Main conclusions: Our results imply that spatial asynchrony is a key to maintaining the stability of ecosystem productivity within a large temperate forest region. We suggest that diverse forests and heterogeneous landscapes should be sustained at multiple spatial scales to buffer the negative effects of climate change and forest degradation.},
	journal = {Global Ecology and Biogeography},
	publisher = {John Wiley \& Sons, Ltd},
	author = {Qiao, Xuetao and Geng, Yan and Zhang, Chunyu and Han, Zhuoxiu and Zhang, Zhonghui and Zhao, Xiuhai and von Gadow, Klaus},
	year = {2022},
	keywords = {alpha diversity, beta diversity, biodiversity, environmental conditions, environmental heterogeneity, gamma stability, metacommunity, stability relationship},
	file = {Qiao et al. - 2022 - Spatial asynchrony matters more than alpha stability in stabilizing ecosystem productivity in a larg 16.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Qiao et al. - 2022 - Spatial asynchrony matters more than alpha stability in stabilizing ecosystem productivity in a larg 16.pdf:application/pdf},
}

@article{ciannelli_theory_2013-2,
	title = {Theory, consequences and evidence of eroding population spatial structure in harvested marine fishes: a review},
	volume = {480},
	issn = {0171-8630},
	url = {https://www.int-res.com/abstracts/meps/v480/p227-243/},
	doi = {10.3354/MEPS10067},
	abstract = {In marine populations, spatial structure arises over a wide range of scales and forms hierarchical aggregations. Changing spatial structure can alter the demographic and life history trait variation within populations and subject individuals to both novel environmental conditions and interspecific interactions. Thus, changes in the spatial structure of marine populations can be a prelude to further changes in abundance and can affect the resilience and recovery potential of populations following anthropogenic and environmental perturbations. These observations under - score the importance of studying the spatial ecology of marine fish populations in order to (1) understand the underlying mechanisms that can lead to rapid alterations in population abundance and community interactions, (2) provide indicators of stock health, and (3) characterize the consequences of changing spatial patterns on population susceptibility to exploitation and environmental variability. Here, we synthesize the interacting factors that influence the formation, maintenance and erosion of spatial structure in marine fish populations and identify the further con sequences of such erosion at the population and community levels. We emphasize human driven changes of population spatial structure for 3 levels of population genetic aggregation that are common in fisheries management scenarios, namely sympatric populations, metapopulations and panmictic populations. Case studies are presented for each level of aggregation. Throughout our review, we both summarize the factors that link spatial and temporal dynamics in marine populations and highlight the management and conservation implications of such linkages. © Inter-Research 2013.},
	journal = {Marine Ecology Progress Series},
	author = {Ciannelli, Lorenzo and Fisher, Jonathan A.D. and Skern-Mauritzen, Mette and Hunsicker, Mary E. and Hidalgo, Manuel and Frank, Kenneth T. and Bailey, Kevin M.},
	month = apr,
	year = {2013},
	keywords = {Fisheries, Population dynamics, Spatial ecology, Spatial structure},
	pages = {227--243},
	file = {Ciannelli et al. - 2013 - Theory, consequences and evidence of eroding population spatial structure in harvested marine fishes 16.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Ciannelli et al. - 2013 - Theory, consequences and evidence of eroding population spatial structure in harvested marine fishes 16.pdf:application/pdf},
}

