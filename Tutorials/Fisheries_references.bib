@article{price_reflection_2026,
	title = {From reflection to action: 20 years of {Canada}’s {Wild} {Salmon} {Policy}},
	volume = {83},
	issn = {0706-652X, 1205-7533},
	shorttitle = {From reflection to action},
	url = {https://cdnsciencepub.com/doi/10.1139/cjfas-2026-0272},
	doi = {10.1139/cjfas-2026-0272},
	abstract = {Twenty years after its adoption, Canada’s Wild Salmon Policy remains a globally signiﬁcant framework intended to conserve Paciﬁc salmon biodiversity, yet implementation has lagged behind its ambition. Drawing on 10 papers in this Special Collection and discussions at a 2026 workshop of researchers and policy practitioners from Indigenous and federal governments, academia, and the non-proﬁt sector, we synthesize ﬁve major themes that deﬁne the current state of Policy implementation. These themes highlight the need to invest in monitoring and assessment capacity, modernize decision frameworks for a changing climate, strengthen governance and accountability, integrate ecosystem processes, and advance rights-based co-governance with Indigenous Peoples. Building on these themes, we present 20 consensus recommendations intended to strengthen implementation of the Wild Salmon Policy and improve the long-term conservation and recovery of wild Paciﬁc salmon.},
	language = {en},
	urldate = {2026-10-05},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	author = {Price, Michael H.H. and Adams, Megan S. and Braun, Douglas and Cleveland, Mark C. and Connors, Katrina and Dennert, Allison M. and Hill, Aaron and Holt, Carrie A. and Hunt, Brian P.V. and Hwang, Jason and Irvine, James R. and Knox, Greg and Lerner, Jacob E. and MacDuffee, Misty and McLaskey, Anna K. and Peacock, Stephanie J. and Pestal, Gottfried and Porter, Marc and Rosenberger, Andrew and Sainsbury, Nigel C. and Saunders, Mark and Sloat, Matthew R. and Whitney, Charlotte and Wilson, Kyle L. and Wong, Janson and Wor, Catarina and Yehle, Kaitlin and Connors, Brendan M.},
