@article{Gutierrez-Estrada2008,
	title = {Estimating fish community diversity from environmental features in the {Tagus} estuary ({Portugal}): {Multiple} {Linear} {Regression} and {Artificial} {Neural} {Network} approaches},
	volume = {24},
	copyright = {http://doi.wiley.com/10.1002/tdm\_license\_1.1},
	issn = {0175-8659, 1439-0426},
	shorttitle = {Estimating fish community diversity from environmental features in the {Tagus} estuary ({Portugal})},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/j.1439-0426.2007.01039.x},
	doi = {10.1111/j.1439-0426.2007.01039.x},
	abstract = {Relationships between environmental variables and diversity (Shannon-Weaver index) of the ﬁsh communities in the Tagus estuary and adjacent coastal areas were analyzed. The focus was on the linearity or nonlinearity of these abiotic ⁄ biotic characteristics, with the aim to obtain an accurate short–medium term time-scale diversity prediction from habitat variables alone. Multiple Linear Regressions (MLR) were used for the linear approach and Artiﬁcial Neural Networks (ANNs) for the nonlinear approach. MLR results in the external validation phase indicated a lack of model accuracy (R2 = 0.0710; \%SEP = 47.5868; E = )0.0217; ARV = 1.0217; N = 43). Results of the best of the Artiﬁcial Neural Networks used in this study (12-15-15-1 architecture) in the external validation phase (ANN: R2 = 0.9736; \%SEP = 7.8499; E = 0.9722; ARV = 0.0278; N = 43) were more accurate than those obtained with MLR. This indicates a clear nonlinear relationship between variables. In the best ANN model, nitrate concentration, depth, dissolved oxygen and temperature were the most important predictors of ﬁsh diversity in the Tagus estuary. The sensibility analysis indicated that the remaining variables (silicate, nitrite, transparency, salinity, slope, phosphate, water particulate organic matter, and chlorophyll a) played lesser roles in the model.},
	language = {en},
	number = {2},
	urldate = {2026-04-20},
	journal = {Journal of Applied Ichthyology},
	author = {Gutiérrez-Estrada, J. C. and Vasconcelos, R. and Costa, M. J.},
	month = apr,
	year = {2008},
	pages = {150--162},
	file = {Gutiérrez-Estrada et al. - 2008 - Estimating fish community diversity from environmental features in the Tagus estuary (Portugal) Mul 16.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Gutiérrez-Estrada et al. - 2008 - Estimating fish community diversity from environmental features in the Tagus estuary (Portugal) Mul 16.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\LDKTF4U5\\Nonlinearity in fish habitat and diversity patterns.pdf:application/pdf},
