@article{Gregory2009,
	title = {Chronology, distribution, and sizes of larval fish sampled by light traps in macrophytic {Chemung} {Lake}},
	volume = {63},
	copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
	issn = {0008-4301, 1480-3283},
