@article{sanchirico_dynamics_2008,
	title = {Dynamics of spatial exploitation: {A} metapopulation approach},
	volume = {14},
	issn = {08908575},
	url = {http://doi.wiley.com/10.1111/j.1939-7445.2001.tb00064.x},
	doi = {10.1111/j.1939-7445.2001.tb00064.x},
	abstract = {In this paper we present a bioeconomic model of a harvesting industry operating over a heterogeneous environment comprised of discrete biological populations interconnected by dispersal processes. The model generalizes the Gordon [1954]/Smith [1968] model of open-access rent dissipation by accounting for intertemporal and spatial “Ricardian” patterns of exploitation. This model yields a simple, but insightful, framework from which one can investigate factors that contribute to the evolution of resource exploitation patterns over space and time. For example, we find that exploitation patterns are driven by biological and fleet dispersal and biological and economic heterogeneity. We conclude that one cannot really understand the biological processes operating in an exploited system without knowing as much about the harvesting system as about the biological system. © 2001 Rocky Mountain Mathematics Consortium.},
	number = {3},
	journal = {Natural Resource Modeling},
	publisher = {John Wiley \& Sons, Ltd},
	author = {Sanchirico, James N. and Wilen, James E.},
	month = jun,
	year = {2008},
	pages = {391--418},
}

