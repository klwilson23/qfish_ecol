	pages = {9757--9764},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\PJNK68N2\\Geophysical Research Letters - 2018 - Jackson - Warming From Recent Marine Heatwave Lingers in Deep British Columbia Fjord.pdf:application/pdf},
}

