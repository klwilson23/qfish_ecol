	pages = {173--207},
	file = {Full Text PDF:C\:\\Users\\kylel\\Zotero\\storage\\MHMLM7XR\\Henri et al. - 2020 - Qanuq ukua kanguit sunialiqpitigu (What should we do with all of these geese) Collaborative.pdf:application/pdf},
