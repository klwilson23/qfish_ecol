	number = {2-3},
	urldate = {2026-04-20},
	journal = {Fisheries Research},
	author = {Campbell, Robert A.},
	month = dec,
	year = {2004},
	keywords = {General linear models, Modelling uncertainty, Spatial distribution of fishing effort, Standardisation of catch rates, Stock abundance indices},
	pages = {209--227},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\VVYW2QVU\\Campbell_2004.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\DVVU4M2A\\Campbell - 2004 - CPUE standardisation and the construction of indices of stock abundance in a spatially varying fishe.pdf:application/pdf},
}

