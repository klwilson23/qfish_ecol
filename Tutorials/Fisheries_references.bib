@article{Baker2025,
	title = {Variation in {Salmon} {Migration} {Phenology} {Bolsters} {Population} {Stability} but {Is} {Threatened} by {Drought}},
	volume = {28},
	issn = {1461-023X, 1461-0248},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ele.70081},
	doi = {10.1111/ele.70081},
	abstract = {Intrapopulation variation in movement is common in nature but its effects on population dynamics are poorly understood. Using movement data from 3270 individually-marked fish representing nine cohorts of coho salmon (Oncorhynchus kisutch) in California, we show that bimodal intrapopulation variation in the timing of juvenile down-migration from their natal habitat and subsequent residence in non-natal habitat affects growth, emigration timing, and the abundance and stability of adult returns. Non-natal fish (early down-migrants) exhibited more variable growth and more variable but earlier emigration to the estuary than natal fish (late down-migrants). While natal rearing was more common, non-natal fish were overrepresented among adult returns, and total returns were 1.4 times more stable than natal returns alone. Our results demonstrate that variation in migratory behaviour bolsters population stability. However, non-natal rearing is reduced in low water years, suggesting that drought exacerbates population instability by reducing critical intrapopulation variation.},
	language = {en},
	number = {2},
	urldate = {2026-04-20},
	journal = {Ecology Letters},
	author = {Baker, Henry K. and Obedzinski, Mariska and Grantham, Theodore E. and Carlson, Stephanie M.},
	month = feb,
	year = {2025},
	keywords = {Pacific salmon, portfolio effect, climate change, life history diversity, diversity-stability relationship, freshwater fish conservation, intraspecific variation, movement ecology, Oncorhynchus, partial migration},
	pages = {e70081},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\UPEY8DHL\\Ecology Letters - 2025 - Baker - Variation in Salmon Migration Phenology Bolsters Population Stability but Is Threatened by.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\WRAQ5CQX\\Baker et al. - 2025 - Variation in Salmon Migration Phenology Bolsters Population Stability but Is Threatened by Drought.pdf:application/pdf},
