	issn = {03801330},
	shorttitle = {Spawning {Behavior} of {Lake} {Trout}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0380133095711066},
	doi = {10.1016/S0380-1330(95)71106-6},
	abstract = {Available information on spawning behavior of lake trout (Salvelinus namaycush) is reviewed to assess factors that affect colonization by this species. Selection of coarse clean substrate appears to be ofprimary importance for successful reproduction. Spawning sites are expected to occur in areas of high currents or wave energy with low particulate accumulation rates. In most lakes, such sites are usually shallow areas along windswept shores. A variety of behavioral stimuli and cues (e.g., chemosensory cues, memory of site, kin recognition) also have the potential of influencing spawning site selection and may ultimately contribute to sympatric stock separation. Overall, the species appears to be rather adaptable and able to colonize new environments that satisfy basic habitat requirements. Behavioral abnormalities do not appear to be responsible for difficulties in reestablishing reproducing populations of lake trout in the lower Great Lakes.},
	language = {en},
	number = {Supplement 1},
	urldate = {2026-04-20},
	journal = {Journal of Great Lakes Research},
	publisher = {Elsevier},
	author = {Gunn, John M.},
	year = {1995},
	keywords = {Behavior, lake trout, rehabilitation, spawning, substrate},
	pages = {323--329},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\RDYRE2U6\\Spawning behaviour of lake trout (Gunn 1995).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\CAS8GEDK\\Gunn - 1995 - Spawning Behavior of Lake Trout Effects on Colonization Ability.pdf:application/pdf},
}

