@article{mccullough_spatially_1996-1,
	title = {Spatially structured populations and harvest theory},
	volume = {60},
	issn = {0022541X},
	url = {https://www.jstor.org/stable/3802033?origin=crossref},
	doi = {10.2307/3802033},
	abstract = {Harvest theory is examined with reference to spatially-structured population systems. Harvest from continuously-distributed populations, which usually are based on regulation of size of kill (numerical control), can be achieved by spatial controls through a mosaic of hunted and unhunted areas. Spatial controls can achieve high yields and avoid the hazards of overharvest that are common with harvest quotas without detailed population data (requiring only an estimate or index of harvest). Harvesting of metapopulations is examined and found to hold little prospect because of negative effects on dispersal required for recolonization of patches following local extinction.},
	number = {1},
	journal = {The Journal of Wildlife Management},
	publisher = {WileyWildlife Society},
	author = {McCullough, Dale R.},
	month = jan,
	year = {1996},
	pages = {1},
}

