@article{Burt2020a,
	title = {Enabling coexistence: {Navigating} predator-induced regime shifts in human-ocean systems},
	volume = {2},
	issn = {25758314},
	url = {https://onlinelibrary.wiley.com/doi/full/10.1002/pan3.10090},
	doi = {10.1002/PAN3.10090/SUPPINFO},
	abstract = {Rapid system-wide changes triggered by predators can pose considerable challenges to people. In the Northeast Pacific, the recovery of sea otters Enhydra lutris following their extirpation due to the 18th and 19th century fur trade is driving a social-ecological regime shift with profound implications. While the ecological consequences of this shift are well documented, very little research has examined the conditions that enable or constrain people's ability to adapt to the social, economic and cultural changes that transpire. Through a collaborative partnership and workshops with Indigenous knowledge holders spanning Alaska to British Columbia, along with quantitative and qualitative interviews in two Indigenous communities among the first to experience sea otter recovery, we examined people's perceptions of the social-ecological conditions that affect their ability to adapt to these changes. We found that communities differed in their relative rankings of adaptation-enabling conditions; however, the following four broad strategies were perceived as critical to improving coexistence with sea otters: (a) strengthening Indigenous governance and decision-making authority; (b) promoting adaptive co-management; (c) weaving Indigenous knowledge and Western science into management plans and (d) establishing learning platforms. Both communities also identified that increased livelihood options and financial assistance would not compensate for lost food security. Differences in enabling conditions and attitudes towards sea otters within and between communities can be attributed to the social-ecological and political context in which sea otter recovery occurs. Our study suggests that enhancing Indigenous peoples' ability to adapt to predator-induced regime shifts will require a transformation in current resource governance systems if we are to navigate towards an ecologically sustainable and socially just operating space. Overall, this work highlights the need for more Indigenous authority, knowledge and leadership in addressing predator-induced regime shifts in coupled human-ocean systems. A free Plain Language Summary can be found within the Supporting Information of this article.},
	number = {3},
	urldate = {2024-10-21},
	journal = {People and Nature},
	publisher = {Blackwell Publishing Ltd},
	author = {Burt, Jenn M. and Wilson, Ḵii'iljuus Barbara J. and Malchoff, Tim and Mack, Wii tsts koom Anne and Davidson, Skil Hiilans Allan and {Gitkinjuaas} and Salomon, Anne K.},
	month = sep,
	year = {2020},
	keywords = {Indigenous knowledge, collaborative management, social-ecological systems, adaptive governance, kelp forests, keystone predator, trophic cascade, predator-recovery},
	pages = {557--574},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\5L4DXMDJ\\full-text.pdf:application/pdf},
}

@article{Pinsky2020,
	title = {Climate-{Driven} {Shifts} in {Marine} {Species} {Ranges}: {Scaling} from {Organisms} to {Communities}},
	volume = {12},
	issn = {19410611},
	doi = {10.1146/ANNUREV-MARINE-010419-010916},
	abstract = {The geographic distributions of marine species are changing rapidly, with leading range edges following climate poleward, deeper, and in other directions and trailing range edges often contracting in similar directions. These shifts have their roots in fine-scale interactions between organisms and their environment-including mosaics and gradients of temperature and oxygen-mediated by physiology, behavior, evolution, dispersal, and species interactions. These shifts reassemble food webs and can have dramatic consequences. Compared with species on land, marine species are more sensitive to changing climate but have a greater capacity for colonization. These differences suggest that species cope with climate change at different spatial scales in the two realms and that range shifts across wide spatial scales are a key mechanism at sea. Additional research is needed to understand how processes interact to promote or constrain range shifts, how the dominant responses vary among species, and how the emergent communities of the future ocean will function.},
	urldate = {2024-10-21},
	journal = {Annual Review of Marine Science},
	publisher = {Annual Reviews Inc.},
	author = {Pinsky, Malin L. and Selden, Rebecca L. and Kitchel, Zoë J.},
	month = jan,
	year = {2020},
	keywords = {climate change, colonization, biogeography, extirpation, food webs, marine-terrestrial comparison},
	pages = {153--179},
}

@article{Post2015,
	title = {Canadian freshwater fishes, fisheries and their management, south of 60°{N}},
	doi = {10.1002/9781118394380.ch11},
	abstract = {Summary Canada has vast quantities of fresh water, covering c. 9\% of its land mass, more than any other country in the world. Southern Canada, south of 60°N, has a relatively depauperate freshwater fish fauna with 147 species exclusively fresh water, 48 species that are anadromous and catadromous or have populations in both freshwater and marine systems and 16 introduced species. These fishes are distributed across nine ecoregions as defined by a combination of faunal similarity and major watersheds. Diversity varies substantially across ecoregions due to variability in glacial history, topography, climate and spatial patterns and abundance of lakes, rivers and wetlands. Recreational fisheries are dominant in these fresh waters where c. 3.71???106 anglers contribute Canadian \$8.3 billion to the economy. The most popular recreational fish species by catch are Sander vitreus (26\%), salmonids (22\%), Perca flavescens (17\%), basses (12\%) and Esox lucius (12\%), and 11\% other species. Canada has some of the best recreational fisheries in the world, yet there is evidence of local overfishing and collapse, in particular in fisheries closest to large urban areas where they are often maintained through stocking. If the combination of human population growth and angling participation rate continue as they have recently, we can expect to see continuing erosion of fishing quality, particularly within the shadows of large cities. Commercial fishing in Canadian fresh waters is relatively modest in landings and value in contrast to Canadian marine commercial fisheries accounting for c. 3\% of the landed volume and 4\% of the total landed value (Canadian \$68???106) of all Canadian commercial fisheries. Sander vitreus, Coregonus spp., P. flavescens and E. lucius are the primary targets for the Canadian freshwater commercial fishery. Effective management of Canada's fresh water fisheries involves managing harvest, habitat and fish stocks. The richness and diversity of fresh waters and their associated fisheries in Canada provide substantial challenges to sustainable management. Approaches involving landscape-scale adaptive management in which fishes, fishers and managers are considered dynamic players in complex resource management system hold promise in sustaining high-quality freshwater fisheries and their substantial social, cultural and economic value to Canada.},
	journal = {Freshwater Fisheries Ecology},
	author = {Post, John R. and Mandrak, Nicholas E. and Burridge, Mary},
	year = {2015},
	note = {ISBN: 9781118394380},
	keywords = {Biodiversity, Recreational fisheries, Commercial fisheries, Ecoregions},
	pages = {151--165},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\AYXSQGBT\\Book Chapter on Canadian Fisheries - August 2013 (Post et al. 2013).pdf:application/pdf},
}

