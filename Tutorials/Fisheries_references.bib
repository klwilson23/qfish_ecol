}

@article{Soule1986,
	title = {What do genetics and ecology tell us about the design of nature reserves?},
	volume = {35},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {00063207},
	url = {https://linkinghub.elsevier.com/retrieve/pii/000632078690025X},
	doi = {10.1016/0006-3207(86)90025-X},
	abstract = {The SLOSS (single large or several small) debate is no longer an issue in the discussion about the optimal size of nature reserves. The best way to estimate the minimum sizes of reserves may be a three-step process: (1) identify target or keystone species whose disappearance would significantly decrease the value or species diversity of the reserve; (2) determine the minimum number of individuals in a population needed to guarantee a high probability of survival for these species; (3) using known densities, estimate the area needed to sustain the minimum number. The forces that affect population viability and determine MVPs (minimum viable populations) are extremely complex. Thoughtful estimates of MVPs for many animal species are rarely lower than an effective size of a few hundred. Attempts to save only common or smaller species in a community will usually be ill-fated because of the web of ecological relationships between species, including the importance of predation and herbivory in the maintenance of species diversity. Other topics discussed include the complementarity of conservation goals, the problematic function of corridors and the value of buffer zones. © 1986.},
	language = {en},
	number = {1},
	urldate = {2026-04-20},
	journal = {Biological Conservation},
	publisher = {Elsevier},
	author = {Soulé, Michael E. and Simberloff, Daniel},
	year = {1986},
	pages = {19--40},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\EJEQJFHW\\1-s2.0-000632078690025X-main.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\9V2LG8CT\\Soulé and Simberloff - 1986 - What do genetics and ecology tell us about the design of nature reserves.pdf:application/pdf},
}

