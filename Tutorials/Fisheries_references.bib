@article{Shepherd2004,
	title = {Density‐dependent habitat selection and the ideal free distribution in marine fish spatial dynamics: considerations and cautions},
	volume = {5},
	copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
	issn = {1467-2960, 1467-2979},
	shorttitle = {Density‐dependent habitat selection and the ideal free distribution in marine fish spatial dynamics},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/j.1467-2979.2004.00143.x},
	doi = {10.1111/j.1467-2979.2004.00143.x},
	abstract = {Current methods and theory used in the study of the spatial dynamics of marine ﬁsh are problematic. Positive relationships between population abundance and occupied area are typically interpreted as evidence of density-dependent habitat selection. However, both abundance and area may co-vary with an un-parameterized variable, such as a density-independent effect. In addition, if density-dependent habitat selection is present, population growth rates in optimal habitats would be expected to be lower than in marginal habitats. This same pattern can also evolve from a largescale, spatially autocorrelated change in a density-independent factor. The theory underlying density-dependent habitat selection, the ideal free distribution, can be tautological when no a priori information of how habitat suitability changes with density is known. In this case, an ideal free distribution can be deﬁned for any pattern of habitat-speciﬁc population growth rates. However, these problems are not insurmountable and solutions may be found by considering spatial variation in proxies of ﬁtness and explicitly allowing for the relative importance of habitat selection (density dependent) and environmental (density independent) effects to vary with spatial scale.},
	language = {en},
	number = {2},
	urldate = {2026-04-20},
	journal = {Fish and Fisheries},
	author = {Shepherd, Travis D and Litvak, Matthew K},
	month = jun,
	year = {2004},
	keywords = {Scale, Spatial distribution, Marine fish, Spatial dynamics, Ideal free distribution, Density-dependent habitat selection},
	pages = {141--152},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\MMFAVCL2\\Density dependent habitat selection in marine fish Shepherd Litvak 2004.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\EXTZVN4X\\Shepherd and Litvak - 2004 - Density‐dependent habitat selection and the ideal free distribution in marine fish spatial dynamics.pdf:application/pdf},
}

