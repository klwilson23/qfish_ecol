@article{hurtado-ferro2015,
	title = {Looking in the rear-view mirror: bias and retrospective patterns in integrated, age-structured stock assessment models},
	volume = {72},
	issn = {1054-3139, 1095-9289},
	shorttitle = {Looking in the rear-view mirror},
	url = {https://academic.oup.com/icesjms/article/72/1/99/2804338},
	doi = {10.1093/icesjms/fsu198},
	abstract = {Retrospective patterns are systematic changes in estimates of population size, or other assessment model-derived quantities, that occur as additional years of data are added to, or removed from, a stock assessment. These patterns are an insidious problem, and can lead to severe errors when providing management advice. Here, we use a simulation framework to show that temporal changes in selectivity, natural mortality, and growth can induce retrospective patterns in integrated, age-structured models. We explore the potential effects on retrospective patterns of catch history patterns, as well as model misspeciﬁcation due to not accounting for time-varying biological parameters and selectivity. We show that non-zero values for Mohn’s r(a common measure for retrospective patterns) can be generated even where there is no model misspeciﬁcation, but the magnitude of Mohn’s rtends to be lower when the model is not misspeciﬁed. The magnitude and sign of Mohn’s rdiffered among life histories, with different life histories reacting differently from each type of temporal change. The value of Mohn’s ris not related to either the sign or magnitude of bias in the estimate of terminal year biomass. We propose a rule of thumb for values of Mohn’s rwhich can be used to determine whether a stock assessment shows a retrospective pattern.},
	language = {en},
	number = {1},
	urldate = {2026-04-20},
	journal = {ICES Journal of Marine Science},
	publisher = {Oxford University Press},
	author = {Hurtado-Ferro, Felipe and Szuwalski, Cody S. and Valero, Juan L. and Anderson, Sean C. and Cunningham, Curry J. and Johnson, Kelli F. and Licandeo, Roberto and McGilliard, Carey R. and Monnahan, Cole C. and Muradian, Melissa L. and Ono, Kotaro and Vert-Pre, Katyana A. and Whitten, Athol R. and Punt, André E.},
	month = jan,
	year = {2015},
	keywords = {simulation, bias, fisheries stock assessment, integrated analysis, retrospective patterns, statistical age-structured models},
	pages = {99--110},
	file = {Full Text:C\:\\Users\\kylel\\Zotero\\storage\\YWSZM7VW\\Hurtado-Ferro et al. - 2015 - Looking in the rear-view mirror bias and retrospe.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\F2P79WT9\\Hurtado-Ferro et al. - 2014 - Looking in the rear-view mirror Bias and retrospective patterns in integrated, age-structured stock assess.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\IQKI4FJB\\Hurtado-Ferro et al. - 2015 - Looking in the rear-view mirror bias and retrospective patterns in integrated, age-structured stock.pdf:application/pdf},
}

@article{Hutchings2011,
	title = {Old wine in new bottles: reaction norms in salmonid fishes},
	volume = {106},
	copyright = {http://www.springer.com/tdm},
	issn = {0018-067X, 1365-2540},
	shorttitle = {Old wine in new bottles},
	url = {https://www.nature.com/articles/hdy2010166},
	doi = {10.1038/hdy.2010.166},
	abstract = {Genetic variability in reaction norms reflects differences in the ability of individuals, populations and ultimately species to respond to environmental change. By increasing our understanding of how genotype × environment interactions influence evolution, studies of genetic variation in phenotypic plasticity serve to refine our capacity to predict how populations will respond to natural and anthropogenic environmental variability, including climate change. Given the extraordinary variability in morphology, behaviour and life history in salmonids, one might anticipate the research milieu on reaction norms in these fishes to be empirically rich and intellectually engaging. Here, I undertake a review of genetic variability in continuous and discontinuous (threshold) norms of reaction in salmonid fishes, as determined primarily (but not exclusively) by common-garden experiments. Although in its infancy from a numerical publication perspective, there is taxonomically broad evidence of genetic differentiation in continuous, threshold and bivariate reaction norms among individuals, families and populations (including inter-population hybrids and backcrosses) for traits as divergent as embryonic development, age and size at maturity, and gene expression. There is compelling inferential evidence that plasticity is heritable and that population differences in reaction norms can reflect adaptive responses, by natural selection, to local environments. As a stimulus for future work, a series of 20 research questions are identified that focus on reaction-norm variability, selection, costs and constraints, demographic and conservation consequences, and genetic markers and correlates of phenotypic plasticity.},
	language = {en},
	number = {3},
	urldate = {2026-04-20},
	journal = {Heredity},
	publisher = {Nature Publishing Group},
	author = {Hutchings, J A},
	month = mar,
	year = {2011},
	keywords = {Phenotypic plasticity, Adaptation, Genetic variation, Genotype-environment interaction, Human-induced evolution, Threshold trait},
	pages = {421--437},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\NJUPXHRB\\Reaction norms in salmonids (Hutchings 2011).pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\PCWDZKCL\\Hutchings - 2011 - Old wine in new bottles reaction norms in salmonid fishes.pdf:application/pdf},
}

