	issn = {0706-652X, 1205-7533},
	url = {http://www.nrcresearchpress.com/doi/10.1139/f95-800},
	doi = {10.1139/f95-800},
	abstract = {Catch-age analysis has become a standard tool for modern stock assessment, where it is recognized that population estimates are linked to estimates of the natural mortality rate M. We use state space models and simulation–estimation cycles to evaluate the performance of catch-age analysis. In particular, we design a simulation model with realistic measurement and process error. We then examine how effectively unknown parameters and population sizes can be obtained from an estimation model simplified to conform with common assumptions. We describe circumstances in which, simultaneously with all other parameters, M is estimable from traditional catch-age data. Increased fishing contrast improves estimates of some model parameters, but not M. The variance ratio ρ relating process error in recruitments with measurement error in the abundance index must be specified in the estimation. We consider both true and ad hoc choices for ρ. In general, estimation models perform better when the true ρ is specified and measurement error is low, so that recruitment error is the dominant source of model variability. Thus, well-designed data collection programs are critical to the correct interpretation of actual fishery data.},
	language = {en},
	number = {10},
