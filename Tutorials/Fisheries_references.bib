@article{Blei2011,
	title = {Posterior {Predictive} {Checks}},
	abstract = {1 Motivation • No model is correct—all models are an approximation (Box). • Some models aren't even that. Many models are convenient formalisms for specifying hidden structure that we want to uncover to form hypotheses or make predictions. • Model building involves three components: estimation, criticism, revision. – Estimation: Estimate (or infer) parameters conditioned on the truth of the model. – Criticism " involves a confrontation of [the model] with available data (old as well as newly acquired) and asks whther [the model] is consonant with [it] " (Box, 1980). – Revision decides how to change the model based on the criticisms (and available time/computing/knowledge resources). We know how to do estimation. We need guidance about criticism and revision. • Today we discuss criticism. – Is my model good enough? – And in what ways isn't it? • This is the art (or mud) of statistics. These questions are vague. • Note that this is different from model comparison. We are not choosing among several models, but deciding whether and in what way to change a model.},
	language = {en},
	journal = {Cos597a},
	author = {Blei, David M},
	year = {2011},
	pages = {1--8},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\IHMD7PUF\\Posterior Predictive Checks.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\6FXHQ463\\Blei - Posterior Predictive Checks.pdf:application/pdf},
}

@article{Blomquist2009,
	title = {Trade-off between age of first reproduction and survival in a female primate},
	volume = {5},
	issn = {1744-9561, 1744-957X},
	url = {https://royalsocietypublishing.org/doi/10.1098/rsbl.2009.0009},
	doi = {10.1098/rsbl.2009.0009},
	abstract = {Trade-offs are central to life-history theory but difficult to document. Patterns of phenotypic and genetic correlations in rhesus macaques,
              Macaca mulatta
              —a long-lived, slow-reproducing primate—are used to test for a trade-off between female age of first reproduction and adult survival. A strong positive genetic correlation indicates that female macaques suffer reduced adult survival when they mature relatively early and implies primate senescence can be explained, in part, by antagonistic pleiotropy. Contrasts with a similar human study implicate the extension of parental effects to later ages as a potential mechanism for circumventing female life-history trade-offs in human evolution.},
	language = {en},
	number = {3},
	urldate = {2026-04-20},
	journal = {Biology Letters},
	author = {Blomquist, Gregory E.},
	month = jun,
	year = {2009},
	keywords = {Life history, Genetic correlation, Quantitative genetics, Maturation, Primate, Senescence},
	pages = {339--342},
	file = {Blomquist - 2009 - Trade-off between age of first reproduction and survival in a female primate 20.pdf:C\:\\Users\\kylel\\My Drive\\SFU REM\\Research\\Mendeley references\\Papers\\Blomquist - 2009 - Trade-off between age of first reproduction and survival in a female primate 20.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\4XNHFP2C\\Tradeoff between age at reproduction and survival (Blomquist 2009).pdf:application/pdf},
}

@article{Boenish2022,
	title = {The global rise of crustacean fisheries},
	volume = {20},
	issn = {1540-9295, 1540-9309},
	url = {https://esajournals.onlinelibrary.wiley.com/doi/10.1002/fee.2431},
	doi = {10.1002/fee.2431},
	abstract = {Globally, wild decapod crustacean fisheries are growing faster than fisheries of any other major group, yet little attention has been given to the benefits, costs, and risks of this shift. We examined more than 60 years of global fisheries landings data to evaluate the socioeconomic and ecological implications of the compositional change in global fisheries, and propose that direct and indirect anthropogenic alterations and enhancements to ecosystems continue to benefit crustaceans. Crustaceans are among the most valuable seafood, but provide low nutritional yields and drive 94\% of the projected increase of global fishery carbon emissions, due to low capture efficiency. Unequivocally, the increasing global demand for luxury seafood comes with serious environmental costs, but also appears to offer lucrative fishing opportunities. The potential for more prosperous fisheries carries unevaluated risks, highlighting the need for a nuanced perspective on global fisheries trade‐offs. Addressing this unique suite of trade‐offs will require substantive changes in both science and management.},
	language = {en},
	number = {2},
	urldate = {2026-04-20},
	journal = {Frontiers in Ecology and the Environment},
	author = {Boenish, Robert and Kritzer, Jacob P and Kleisner, Kristin and Steneck, Robert S and Werner, Karl Michael and Zhu, Wenbin and Schram, Frederick and Rader, Douglas and Cheung, William and Ingles, Jose and Tian, Yongjun and Mimikakis, John},
	month = mar,
	year = {2022},
	pages = {102--110},
	file = {PDF:C\:\\Users\\kylel\\Zotero\\storage\\FB6EGGGQ\\Frontiers in Ecol   Environ - 2021 - Boenish - The global rise of crustacean fisheries.pdf:application/pdf;PDF:C\:\\Users\\kylel\\Zotero\\storage\\V6JSU8DW\\Boenish et al. - 2022 - The global rise of crustacean fisheries.pdf:application/pdf},
}

